model {

  // ═════════════════════════════════════════════════════════════════════════════
  // THE MACHINE — one command in, background workers out.
  // Every value here was read off CLI/bin/sf, CLI/src/beads-loop/ (index.sh and the nine beside it),
  // CLI/utils/console.sh, CLI/utils/logging.sh,
  // CLI/utils/forge.sh, CLI/utils/spawn.sh, CLI/utils/user-env.sh, scripts/clone-webs.sh,
  // CLI/spider-factory.example.env,
  // CLI/src/agent-hooks/worker-stop.sh.
  // The cast only: the story is told by the four walkthroughs in views.c4.
  // Rules for editing these files: ./REFERENCE.md — the code is the only source of truth.
  // ═════════════════════════════════════════════════════════════════════════════

  machine = layer "The machine — one command in, background workers out" {
    summary "One command in, background workers out: the command, the installer, the webs cloner, the checks, the parameters, the dispatcher, the claim."

    sfCli = cliTool "sf — the one command, and its eight" {
      summary "The whole CLI: one bash file, eight commands, each one an engine beside it. Every one but bare `sf` runs only from inside the factory."
      link https://github.com/Londelo/spider-factory/blob/main/CLI/bin/sf "Source — CLI/bin/sf"
    }

    installer = cliTool "CLI/install-cli.sh — put sf on your path" {
      summary "One bash script you run yourself: it writes the `sf` launcher at `~/.local/bin/sf` and, the first time only, the parameters file."
      link https://github.com/Londelo/spider-factory/blob/main/CLI/install-cli.sh "Source — CLI/install-cli.sh"
      link https://github.com/Londelo/spider-factory/blob/main/CLI/uninstall-cli.sh "Source — CLI/uninstall-cli.sh"
    }

    websCloner = cliTool "npm run webs:clone — the webs the factory builds" {
      summary "Clone every repo url in `webs/webs.yml` into `webs/` beside it. Never pulls, never resets, never deletes; `sf` has no webs command."
      link https://github.com/Londelo/spider-factory/blob/main/scripts/clone-webs.sh "Source — scripts/clone-webs.sh"
      link https://github.com/Londelo/spider-factory/blob/main/webs/webs.example.yml "Source — webs/webs.example.yml"
    }

    preflight = noteDoc "The checks — everything that must hold before the first tick" {
      summary "The eight checks that must hold before the first tick; seven of them refuse the run outright."
      link https://github.com/Londelo/spider-factory/blob/main/CLI/src/beads-loop/index.sh#L122-L136 "Source — beads-loop/index.sh lines 122–136, the bootstrap that runs them in order"
      link https://github.com/Londelo/spider-factory/blob/main/CLI/src/beads-loop/preflight.sh#L5-L45 "Source — beads-loop/preflight.sh lines 5–45, checks 2–5 and 8"
      link https://github.com/Londelo/spider-factory/blob/main/CLI/utils/spawn.sh#L29-L39 "Source — CLI/utils/spawn.sh lines 29–39, requireAgentDefinition, the file check check 8 runs"
      link https://github.com/Londelo/spider-factory/blob/main/CLI/utils/console.sh "Source — CLI/utils/console.sh, die, the four reused refusals and the one beads probe"
    }

    knobs = knobPanel "The run's parameters (env, read once at startup)" {
      summary "The run's parameters, read once at startup out of `CLI/spider-factory.env`; what you export yourself still wins."
      link https://github.com/Londelo/spider-factory/blob/main/CLI/spider-factory.example.env "Source — CLI/spider-factory.example.env"
      link https://github.com/Londelo/spider-factory/blob/main/CLI/utils/user-env.sh "Source — CLI/utils/user-env.sh"
    }

    dispatcher = dispatcher "beads-loop/ — the dispatcher" {
      summary "The engine: a tick dispatches any ready gate its tier flag opens, then claims one ready ticket, derives its branch off the id, spawns its worker."
      link https://github.com/Londelo/spider-factory/blob/main/CLI/src/beads-loop/index.sh "Source — CLI/src/beads-loop/index.sh, the tick and the run"
      link https://github.com/Londelo/spider-factory/tree/main/CLI/src/beads-loop "Source — the whole CLI/src/beads-loop/ directory, the ten files"
      link https://github.com/Londelo/spider-factory/blob/main/CLI/utils/console.sh "Source — CLI/utils/console.sh, the run's terminal lines"
    }

    agentMap = noteDoc "The AGENT map — the only label→worker binding" {
      summary "The seven labels that dispatch, each bound to one worker; nothing else picks a worker."
      link https://github.com/Londelo/spider-factory/blob/main/CLI/src/beads-loop/index.sh#L21-L31 "Source — beads-loop/index.sh lines 21–31, the AGENT map and the lead agent's name"
    }

    hookFields = knobPanel "SF_* — the nine log fields the Stop hook fills itself" {
      summary "The SF_ variables the Stop hook exports inside its own process, filled off this session's dispatched claims line. The spawn sets none."
      link https://github.com/Londelo/spider-factory/blob/main/CLI/src/beads-loop/worker.sh#L54-L75 "Source — beads-loop/worker.sh lines 54–75, spawnWorker: the context file, then the spawn through spawnBackgroundAgent with no environment in front of it, then the proof"
      link https://github.com/Londelo/spider-factory/blob/main/CLI/src/agent-hooks/worker-stop.sh#L82-L117 "Source — CLI/src/agent-hooks/worker-stop.sh lines 82–117, adoptDispatchContext: the claims line becomes the hook's own nine fields"
    }

    claim = cliTool "bd ready --claim — the hand that takes one ticket" {
      summary "bd ready --claim — takes one unblocked ticket atomically and starts its five-minute lease."
      link https://github.com/Londelo/spider-factory/blob/main/CLI/src/beads-loop/claim.sh "Source — CLI/src/beads-loop/claim.sh, the frontier and the guards"
      link https://github.com/Londelo/spider-factory/blob/main/CLI/src/beads-loop/gates.sh#L13-L47 "Source — CLI/src/beads-loop/gates.sh lines 13–47, dispatchOneGate: the claim made by status"
    }

  }  // machine

  logRun = logStore "~/.spider-factory/logs/<date>_<time> — one dir per run" {
    summary "One timestamped directory per run, holding every file that run writes."
    link https://github.com/Londelo/spider-factory/blob/main/CLI/utils/logging.sh "Source — CLI/utils/logging.sh, the one definition of a line"

    fClaims = logFile "claims" {
      summary "Every ticket taken, and the epic branch the first time it is published."
    }
    fErrors = logFile "errors" {
      summary "Every failure, whoever saw it, and never rate-limited."
    }
    fWaiting = logFile "waiting" {
      summary "The quiet ticks, one line a minute per reason."
    }
    fCloses = logFile "closes" {
      summary "One line per ticket that landed, with its pull request url."
    }
    fResults = logFile "results" {
      summary "The run's tally of ticks, claims and tickets closed, at the ticket cap or on Ctrl-C."
    }
    fBdStderr = logFile "bd-stderr" {
      summary "Stderr of the last claim, quoted on a claim failure."
    }
    fClaudeStderr = logFile "claude-stderr" {
      summary "Stderr of the last capacity count."
    }
    fSpawn = logFile "spawn-<ticket>" {
      summary "That one worker's raw spawn output, which holds its session id."
    }
  }

  stopHook = hook "worker-stop.sh — the Stop hook, fail-closed" {
    summary "The closer, registered by each worker agent's own frontmatter: only a session the harness reports `done` may commit, push and close; every other verdict leaves the ticket claimed."
    link https://github.com/Londelo/spider-factory/blob/main/CLI/src/agent-hooks/worker-stop.sh "Source — CLI/src/agent-hooks/worker-stop.sh"
  }

  overseerAgent = worker "overseer — the reader, never the hand" {
    summary "`sf overseer`: reads this directory's tower and its run logs and reports back to you, foreground. It has no Write, Edit or Agent tools."
    description """
**The file:** `.claude/agents/overseer.md`, run in the **foreground** by `sf overseer` →
`CLI/src/overseer-agent.sh` → `runForegroundAgent overseer "<launch brief> <your prompt>"`
(`CLI/utils/spawn.sh`), which proves the agent file exists and then `exec`s the verbatim form
`$SF_AGENT_LAUNCH_COMMAND --agent overseer "<launch brief> <your prompt>"`. **No `--bg`, no `-n`, no
`--disallowedTools`, no permission flag** — the two foreground and background forms differ by `--bg` and the
session name and nothing else. `requireAgentCommand` checks the first word of the plain `SF_AGENT_COMMAND` on
`PATH` first, and the `exec` means there is no after: the file check is the whole proof this engine can have.
Foreground is the whole difference from a worker — a worker is spawned `--bg` with nobody watching and reports
through the log; the overseer talks back to you and can still stop and ask.

**Its job, off its own frontmatter:** *"Reads a beads tower and reports honestly on it: the beads database of the
directory it was spawned in, plus the `sf loop` log files that directory's runs have left behind."* It knows how a
tower got where it is — what each plan agent writes, tier by tier, what a gate is, what should be running next —
which is what lets it tell a real fault from a tier simply waiting on a human. **Skill it loads: `bead-read`.**
Tools: `Read, Grep, Glob, Bash` — **no `Write`, no `Edit`, no `Agent`**, and no `hooks:` block, so a watcher
ending its session never commits, pushes, opens a PR or parks a ticket.

**Two of its facts come from the launch brief, never from its own environment.** `runOverseer` interpolates its
own `SF_LOG_ROOT` and `SF_AGENT_COMMAND` into the prompt — *"the run logs live under `<log root>`, and background
sessions are listed by `<agent command> agents --json`. Take those two from this brief; never read either off your
own environment."* — and `overseer.md` writes them as `<log root>` and `<agent command>` throughout. The watcher is
a session like any other: whatever its shell carries about a run can belong to a different one.

| Guard | What it stops |
|---|---|
| no `Write`, `Edit` or `Agent` tools in its own file | writing a file, or spawning a worker of its own — this is the guard; nothing is denied at the command level |
| `requireBeadsProject`, then the first word of `SF_AGENT_COMMAND` on `PATH` | running it outside a tower, or with an agent command that does not exist |
| no `hooks:` frontmatter | a watcher ending its session committing, pushing or closing anything |

**Where the fix is a mutation, it hands you the command to run** — e.g. `bd update <ticket> --status
failed-agent`. That is the design, not a limitation: claim, unclaim, close, commit and push belong to the loop and
its hooks, and a reader that could do them itself would be a second loop nobody dispatched.
"""
    link https://github.com/Londelo/spider-factory/blob/main/.claude/agents/overseer.md "Source — .claude/agents/overseer.md"
    link https://github.com/Londelo/spider-factory/blob/main/CLI/src/overseer-agent.sh "Source — CLI/src/overseer-agent.sh"
  }

  towerView = cliTool "CLI/src/tower/index.sh — the whole database as one tree" {
    summary "`sf tower`: every ticket of every status as one tree, in the order the loop works them. Two `bd` reads, one jq program, nothing written."

    link https://github.com/Londelo/spider-factory/blob/main/CLI/src/tower/index.sh "Source — CLI/src/tower/index.sh"
    link https://github.com/Londelo/spider-factory/blob/main/CLI/src/tower/tower.jq "Source — CLI/src/tower/tower.jq"
  }

  beads = beadsStore "beads DB (bd) — the tower" {
    summary "The database holding every gate, ticket and edge — the loop's only runtime input."
    link https://github.com/Londelo/spider-factory/blob/main/.claude/skills/bead-initialize/SKILL.md "Source — the bead-initialize skill"
  }

  forge = forge "origin — GitHub or GitLab" {
    summary "The remote the tower publishes to: one pull request per branch."
    link https://github.com/Londelo/spider-factory/blob/main/CLI/utils/forge.sh "Source — CLI/utils/forge.sh"
  }

  toolbelt = layer "The commands the loop shells out to" {
    summary "The commands the loop shells out to: the ticket tool, the agent command, git, the forge tool, the folder."

    bdCmds = noteDoc "bd — the only reads and writes the tower answers to" {
      summary "The ticket commands the tower answers to, and why each one is that one."
    }

    claudeCli = cliTool "$SF_AGENT_COMMAND (claude) — the command every agent runs through" {
      summary "The command every agent runs through; the launch form off it is what CLI/utils/spawn.sh spawns with, and it proves every one of those spawns."
    }

    gitCli = cliTool "git — worktrees, fetch, push" {
      summary "The git the loop runs: is a branch checked out, make its folder, fetch, push."
    }

    forgeCli = cliTool "gh / glab" {
      summary "gh or glab, whichever the remote settled on: find the branch's pull request, open one if none."
    }

    worktree = branchBox "the branch's folder — .claude/worktrees/<branch with / → +>" {
      summary "One folder per branch, where every ticket of that feature works in turn."
    }

  }  // toolbelt

  human = human "Human (Brodie)" {
    summary "Closes the gates and nothing else — until a tier's flag hands that gate to the lead agent."
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // THE WORKERS — the spokes. Each is one agent file, dispatched by one label.
  // ═════════════════════════════════════════════════════════════════════════════

  workers = layer "The workers" {
    summary "The seven workers: six are reached by a label, the seventh — the lead — only by a gate."
    engineer = worker "engineer" {
      summary "Business logic, endpoints, hooks, types, error factories; never tests, JSX or CSS."
      description """
**Label `backend-logic` → `engineer`.** Head of every feature's linked line: its commit is what the micro tests and
then the UI are built against.

**Job, from `.claude/agents/engineer.md`:** "Writes clean, maintainable business logic, backend endpoints, React
hooks, type guards, error factories, and pipelines. Follows the FP+imperative paradigm and project coding standards.
Never writes tests, JSX, or CSS."

**Skills it preloads:** `bead-read`, `bead-comment`, `standards-coding`, `standards-errors`,
`standards-file-organization`, `standards-naming`. **Tools:** `Read, Write, Edit, Bash, Grep, Glob`.
Contract, report section and `## Commit As You Go` are in that same file — see the workers layer.
"""
      link https://github.com/Londelo/spider-factory/blob/main/.claude/agents/engineer.md "Source — .claude/agents/engineer.md"
    }
    testerUnit = worker "tester-unit" {
      summary "Micro tier: one back-end function alone — every branch, boundary and error it throws."
      description """
**Label `unit-tests` → `tester-unit` — the micro tier.** Second in the linked line, behind the back-end ticket it
tests.

**Job, from `.claude/agents/tester-unit.md`:** "The micro tier of the test system: tests one BACK-END function at a
time, alone, and inside that function it is exhaustive — every branch, every boundary, every error it can throw,
every edge case. Owns the input matrix and nothing above it. Back-end only: it never touches components — the UI is
proved by the feature tier." Framework-agnostic by design: it decides **what** to cover, the loaded framework skill
supplies the **how**. Never writes wiring, composition, browser or journey tests, and never writes production code.

**Skills it preloads:** the six the engineer carries, plus `framework-jest`. **Tools:** `Read, Write, Edit, Bash,
Grep, Glob`.
"""
      link https://github.com/Londelo/spider-factory/blob/main/.claude/agents/tester-unit.md "Source — .claude/agents/tester-unit.md"
    }
    frontend = worker "frontend" {
      summary "Components, layout and styling, last in the line against functions already proved."
      description """
**Label `frontend-ui` → `frontend`.** Last of the three in the linked line, built against functions already proved;
its landing is what unblocks the feature's composition test.

**Job, from `.claude/agents/frontend.md`:** "Builds UI components, layouts, and styling. Manages the shared component
system and design tokens. Never writes business logic, API endpoints, or tests."

**Skills it preloads:** `bead-read`, `bead-comment`, `standards-coding`, `standards-errors`,
`standards-file-organization`, `standards-naming`. **Tools:** `Read, Write, Edit, Bash, Grep, Glob`.
"""
      link https://github.com/Londelo/spider-factory/blob/main/.claude/agents/frontend.md "Source — .claude/agents/frontend.md"
    }
    testerFeature = worker "tester-feature" {
      summary "Composition tier: one feature's pieces proved wired, its errors and successes surfacing."
      description """
**Label `feature-test` → `tester-feature` — the composition tier.** Always `.1` of its feature: the first thing the
lead agent counts when it proves the tier.

**Job, from `.claude/agents/tester-feature.md`:** "The middle tier of the test system: proves one feature's pieces
are actually wired together — the small unit-tested functions and components composed correctly, and every error and
success the feature encapsulates actually surfaces. Deliberately NOT exhaustive: it never re-runs the unit tier's
edge-case matrix, and never walks cross-feature journeys (tester-e2e owns those)." Reads its ticket plus what blocks
it and the gate it blocks, and works that alone; never writes production code.

**Skills it preloads:** the six the engineer carries, plus `framework-playwright`. **Tools:** `Read, Write, Edit,
Bash, Grep, Glob`.
"""
      link https://github.com/Londelo/spider-factory/blob/main/.claude/agents/tester-feature.md "Source — .claude/agents/tester-feature.md"
    }
    testerE2e = worker "tester-e2e" {
      summary "Broad tier: whole user journeys across features in a real browser on the real stack."
      description """
**Label `epic-e2e-test` → `tester-e2e` — the broad tier.** Always the epic's `.1`: it runs only after every feature
gate is closed, so it is testing a finished thing.

**Job, from `.claude/agents/tester-e2e.md`:** "The broad tier of the test system: writes end-to-end tests that walk
whole user journeys across features in a real browser against the real stack, proving the features play nicely
together — cross-feature state handoffs, session continuity, and each feature's success and failure surfacing to the
user. The least verbose tier of the three: one journey per user-visible outcome, never re-testing the unit tier's
edge cases or the feature tier's wiring." Reads its ticket plus the epic gate, the feature gates and their tiers
where they apply; never writes production code.

**Skills it preloads:** the six the engineer carries, plus `framework-playwright`. **Tools:** `Read, Write, Edit,
Bash, Grep, Glob`.
"""
      link https://github.com/Londelo/spider-factory/blob/main/.claude/agents/tester-e2e.md "Source — .claude/agents/tester-e2e.md"
    }
    reviewAgent = worker "review" {
      summary "Three questions as PR comments, then every finding handed one at a time to the agent that owns its fix."
      description """
**Labels `feature-review` and `epic-review` → `review`.** Always `.2` of its feature, and the epic's `.2`.

**Job, from `.claude/agents/review.md`:** reads its ticket and the tickets around it, reads the diff, maps the whole
system the change touches, instruments it with trace logs, runs the tests against the instrumented code, then
answers three questions from first principles — **does the code do what its source of truth demands, do the tests
actually prove it, is it simple and readable** — posts every finding as its own PR comment, hands each finding once
to the one agent that owns that kind of fix, and stops there.

**Tools:** `Read, Write, Edit, Grep, Glob, Bash, Skill, Agent` — the only agent file in the tower with `Agent`.
**No `skills:` key at all**: everything loads on demand at the step that uses it — `bead-read` + `bead-comment` at
Step 1, the four `standards-*` at Step 6, `pr-comments` at Step 7.

| Surface | What goes there |
|---|---|
| The pull request | **every finding, one comment each**, pinned to the line it belongs to and complete enough to fix from, plus one summary comment with the whole picture |
| Its own ticket | its **result**, through `bead-comment` — a different surface from the findings, exactly as every other worker's |
| Its final message | dies with the session; nothing depends on it |

**It writes nothing that lands.** Files no tickets, **creates no files at all**, runs no `git add` / `git commit` /
`git push`. Its only writes are Step 4's trace logs, into files that already exist — and because `sf commit` runs
`git add -A`, anything left there would ride onto the branch it is judging, so it **strips them back out and proves
it with `git status`** before stopping.

**Base and branch.** Branch = `git branch --show-current`, the only thing it trusts — never its own environment,
which the shared daemon froze at the run's first spawn and which can name another worker's branch. Base = the **epic
gate's** `branch` metadata, read off `<repo>-epic-<uuid>-0` with `bd show --json`; `main` when its own hierarchy
starts at `0`. **An empty `git diff --stat` is a finding, never a pass** — either the base resolved wrong or the
branch holds nothing; it says which and stops.

**Step 8 — one round of fixers, then it stops looking.** One fixer per finding, **one at a time**, spawn → wait for
its report → spawn the next; never two on the branch together, because they share one worktree and step on each
other's commits. Routing is by **what the fix has to touch**, never by severity nor by which question raised it:
`engineer` for logic, data, a hook, an endpoint, an error path, or a standard broken in non-UI code · `frontend` for
a component, JSX, layout, styling, anything the user sees · and for behaviour no test could have failed on, the test
tier matched to the **depth of the gap** (unit = one back-end function alone, feature = one feature's pieces wired,
e2e = a journey across features), one tier down when the depth is unclear. A finding needing both a change and its
proof is **two spawns**, still in sequence — a fixer never writes what another tier owns. Each fixer arrives knowing
nothing, so **the finding's own PR comment, pasted verbatim, is the whole brief**, beside only the comment's url, the
branch, and the review ticket's name; a comment that is not enough to fix from was never a finished finding, and the
missing detail goes back onto the PR before the spawn. **Every prompt ends with three constraints:** fix this finding
and nothing beside it · commit it yourself with `sf commit` · touch no ticket. A fixer has no ticket, so its own
`## Report On The Ticket` stays shut and the hook finds no `reason=dispatched` line for a session the loop never
spawned — it closes nothing. Each fixer is its own session and its own `Stop` finishes it, so a fixer reporting back
can never close the review ticket out from under review. Then review re-runs no step, reads no fixer's diff, fixes
nothing a fixer left broken, and spawns no second round.

**Then it resolves only its own threads** — and only the ones whose fix landed. `pr-comments` is posting-only and
owns no resolve verb, so these calls live in this agent's own file: GitHub resolves a **thread**, so it reads thread
ids off `gh api graphql … reviewThreads` then fires `resolveReviewThread`; GitLab resolves a **discussion** with
`glab api --method PUT …/discussions/<id> -f resolved=true`. A finding whose fixer came back wrong, or came back
saying it was not a defect, stays **open** — an open thread is the human's signal. Never approves, never merges:
those are the person's, and the `lead` agent's.
"""
      link https://github.com/Londelo/spider-factory/blob/main/.claude/agents/review.md "Source — .claude/agents/review.md"
    }
    leadAgent = worker "lead" {
      summary "The one worker no label reaches: stands on a gate, proves the tier, merges the branch through the forge."
      description """
**No label reaches this agent — a gate does.** `leadAgentName=\"lead\"` sits beside the `AGENT` map, not inside
it: the loop spawns the lead only from `dispatchOneGate`, for a ready gate whose tier flag is on, with the identity
`agent=lead label=gate:<tier>` and the session name `lead:<gate>`. Everything below it is already committed, pushed,
reviewed and closed; its whole job is to find out whether any of that is a lie.

**Job, from `.claude/agents/lead.md`:** "Closes a gate. Runs on a feature gate or the epic gate and proves the tier
it stands for — every ticket under the gate closed, the review run and its findings fixed on the branch, the
project's own tests green, the pull request's pipeline green — then merges that branch's pull request into its
target. Writes no code and no tests; it resolves conflicts only where the target moved under the branch. Never
merges by hand, never pushes a merge of its own making into the target."

**Skills it preloads:** `bead-read`, `bead-comment` — nothing else. **Tools:** `Read, Write, Edit, Grep, Glob, Bash`.

**A closed ticket is a claim, not a fact.** Proof is four checks, each read out with its numbers: every ticket that
blocks the gate is closed · this tier's review actually reviewed and every finding is answered on the branch · the
project's own test command exits `0` **with a count above zero** (the epic tier runs the end-to-end command too) ·
the PR's pipeline is green, where queued and skipped are **not** green. Any one failing → it says *this gate is not
proved*, comments the gate naming what is missing, and stops: the gate stays claimed and a human is told why.

**Step 8 is the report, and it goes on the gate** — one line per ticket in the tier, the test command with its count,
each pipeline check, each review finding and how it was answered, the merge with its result — filed through
`bead-comment` before it stops, because the final message dies with the session and the gate is the only thing the
person closing it can still read.

**Merge, and only now** — `gh pr merge` / `glab mr merge` on that branch's PR into its **`prTarget`**, which Step 1
derived off the gate's own id: the epic gate's `branch`, or `main` when the gate *is* the epic gate. The forge does
the merge — never a local `git merge` into the target, never a push to the target, never a rebase. Where the target
moved under the branch it brings the target *into this branch* with one command and no others:
`git -c merge.conflictStyle=diff3 merge origin/<prTarget>`. A plain `git merge` hands over two sides with no
`|||||||` base section showing what the code looked like before either side touched it, and that base is the only
legitimate way to choose between two sides; the setting is asked for **on the command line, never written into
anyone's config**. A test file in that conflict is **spliced, never chosen** — union of the cases, both sides kept,
and where both assert they are made to agree by fixing the code, never by silencing an assertion: a test weakened to
end a conflict makes everything above the gate a lie. The resolution goes through `sf commit` and a push, so the PR
carries it and the pipeline re-runs. Never closes, reopens, unclaims or reclaims a ticket — `bd close` would end the
hook before it ever ran.
"""
      link https://github.com/Londelo/spider-factory/blob/main/.claude/agents/lead.md "Source — .claude/agents/lead.md"
    }
  }

  planAgents = layer "The plan agents (outside the tower)" {
    summary "The judgments the machine never makes: what the epic is, what a feature is, the order in one."
    planEpic = planner "plan-epic" {
      summary "A vague idea into exactly one epic gate plus its end-to-end and review tickets."
      description """
**Job, from `.claude/agents/plan-epic.md`:** "Conversational epic architect. Turns a vague idea into exactly one epic
gate plus its e2e and review tickets, through targeted questions and real research."

**Tools:** the widest planner list — `Read, Write, Edit, Bash, Grep, Glob, Skill, TaskCreate, TaskUpdate, TaskList,
TaskGet, WebSearch, WebFetch, mcp__searxng__*`. It is the only planner that researches a vague idea and writes down
what it found; the other two carry `Read, Bash, Grep, Glob, Skill` and nothing else. **No `skills:` key** — it loads
`bead-create` for the row shapes at the moment it writes rows.

**How it behaves.** `ask 1–2 questions at a time until you understand the *what* → synthesize → show it back, adjust
→ create`, and "the user needs the right questions, not a lecture". Questions live in the task list
(`TaskCreate` each one the moment it is thought of), never held in its head. Surveyed before creating, so no
duplicate epic.

**Create in the order they run** — gate first, with its `branch` and nothing else in metadata, then the e2e suite,
then the review. The gate goes first because it is the only row anywhere that carries a branch name, and both tickets
below it resolve their git world through it.

**What it writes:** exactly one epic gate plus `epic-e2e-test` and `epic-review`, and nothing else — **there is no
merge ticket** at any tier and no label for one, because the lead agent merges from the gate. Gate id from
`create-gate.sh <repo>` (fresh uuid, hierarchy `0`); one key written, `branch: epic/<slug>`, onto the gate alone. The
two tickets carry **no metadata at all** and take an explicit `--id` from `create-task.sh <repo> <epicGate> suite` and
`… review`, so they read `0.1` and `0.2`. The epic's PR aims at `main` — derived, never written, and the one merge in
the tower that reaches `main`. **Three edges:** suite blocks the gate, review blocks the gate, review waits on the
suite. Builds the tower and does no work in it.
"""
      link https://github.com/Londelo/spider-factory/blob/main/.claude/agents/plan-epic.md "Source — .claude/agents/plan-epic.md"
    }
    planFeature = planner "plan-feature" {
      summary "An epic into complete user-facing flows, each with its own branch, suite and review."
      description """
**Job, from `.claude/agents/plan-feature.md`:** "Breaks an epic into feature-sized features — complete user-facing
flows — each with its own branch, its own PR, and its feature-test and review tickets, phased by dependency and
naming the stack. Runs automatically off an epic id, or asks which epic when none is given; **no epic is a valid
answer**."

**Tools:** `Read, Bash, Grep, Glob, Skill` — no `Write`, no `Edit`: it writes tickets through `bd` and writes no file
anywhere. **Skills it preloads:** `standards-naming`, `standards-file-organization`.

**What it writes.** One gate per flow, phased foundations → core → dependent → polish, each with its own
`feature/<slug>` written onto its gate and nowhere else. Gate id from `create-gate.sh <repo> <epicGateId>`, which
copies the epic's uuid and numbers the next feature; its `feature-test` and `feature-review` tickets carry **no
metadata** and take an explicit `--id` from `create-task.sh <repo> <gate> suite|review`, so they read `<n>.1` and
`<n>.2`. Where a feature's PR merges is never written here — the loop takes the gate's uuid, names the epic gate of
that tower and reads its `branch`; a feature whose id names no epic gate is not aimed at `main`, it is refused
(`ERROR reason=no-epic-gate`). **No merge ticket at this tier**: a feature has one branch and its tasks are the
commits onto it.

**Four edges per feature** — suite blocks the gate, review blocks the gate, review waits on the suite, and **this
feature's gate blocks the epic's `epic-e2e-test`**, which is what holds the epic tier off the frontier until every
feature has merged.
"""
      link https://github.com/Londelo/spider-factory/blob/main/.claude/agents/plan-feature.md "Source — .claude/agents/plan-feature.md"
    }
    planTask = planner "plan-task" {
      summary "One feature into its tasks, chained one to the next, every one blocking the feature's gate."
      description """
**Job, from `.claude/agents/plan-task.md`:** "Automatically breaks ONE feature into granular worker tasks —
implementation and micro tests — chained one to the next, each with requirements, edge cases and file paths, every
one of them blocking the feature's gate. Requires a feature ticket in the prompt and refuses without one." Asks
nothing, ever — it either has a feature or it refuses.

**Tools:** `Read, Bash, Grep, Glob, Skill` — no `Write`, no `Edit`. **Skills it preloads:** `standards-naming`,
`standards-file-organization`.

**What it writes.** One feature → its tasks, **labelled at creation** with `bd create -l <label>`, each created with
an explicit `--id` from `create-task.sh <repo> <featureGate>` run once per task in chain order, and **no metadata at
all** — not even a `branch`: the loop reads the uuid off that id and takes both branches off the two gates it names.
A plan agent never invents a branch below its own tier, and refuses with `ERROR reason=metadata-missing` when the
feature's gate carries no `branch` of its own. Before writing each ticket it reads that kind's section-by-section
template — `engineer.md` for `backend-logic`, `frontend.md` for `frontend-ui`, `tester-unit.md` for `unit-tests` —
three files under `.claude/shared/plan-tasks/` in the **factory checkout** (one of its working directories; its cwd
stays in the tower, where no template exists, because cwd decides which beads database `bd` reads). If its draft
disagrees with the template, **the template wins**.

**Two edges per task, and this is the whole job.** `bd dep add "$gate" "$task" --type blocks` plus
`bd dep add "$task" "$previous" --type blocks`, first task excepted — one linked line, never a fan:

| Edge | What it enforces |
|---|---|
| task → gate | makes the ticket **part of the tier**. That set of blockers *is* the list the lead agent reads when it asks whether the feature is proved |
| task → the one task before it | orders the build. One predecessor, never two, never "all of the above"; the first waits on nothing and is the only thing the frontier sees when the feature starts |
| chain tail → `feature-test` | one extra edge, plan-task's own: the suite proves nothing until the whole line of commits exists |

**The hazard on this tier:** a missing edge is doing something worse than nothing. The tier edge is the only thing
that keeps one feature down to one ready ticket, so two tasks released together are **two workers committing to one
branch at once** — and a row whose tier edge silently isn't there still runs, is invisible to `bd ready`'s tier list,
and **the lead agent never counts it: the gate closes over it.** Order inside the line is logic → its tests → the UI:
shared types and error factories first, then each back-end function with its `unit-tests` ticket immediately behind it
(so a test never waits on UI it does not test), then components, then polish — the UI last because a page is built
against functions that already hold, not against a guess at them.

**Not its:** the suite's and review's edges to each other and to the gate (`plan-feature` wired those), the feature's
branch name (the gate owns it), anything at the epic tier. Refuses outright without a feature in the prompt:
`ERROR reason=no-parent-feature`. Every ticket verified with a `bd show --json` round trip, `dependencies` among the
fields checked.
"""
      link https://github.com/Londelo/spider-factory/blob/main/.claude/agents/plan-task.md "Source — .claude/agents/plan-task.md"
    }
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // THE TOWER — a worked example. The machine above is verified against source;
  // this tower is an INVENTED example (a record box) used so the walkthroughs can
  // name real labels, branches and log lines.
  // ═════════════════════════════════════════════════════════════════════════════

  tower = layer "The tower — worked example: one epic, one feature" {
    summary "A worked example: one epic, one feature, nine tickets named by what they are."
    epic = gate "Epic gate" {
      summary "The epic gate — the what; closed once after the epic review, by a person or by the lead agent."
      description """
**What it is:** the epic gate — the *what*; closed once, after `epic-review`, by a person, or by the lead agent
when `SF_AGENT_EPIC_GATES=1`.

```
id:       box-epic-7f3a9c-0          ← the kind word says epic, the hierarchy 0 says top of the tower
type:     gate                       (custom type: bd config set types.custom \"gate\")
labels:   none — a gate carries zero labels, so no label can ever dispatch anything to it
branch:   epic/record-box            ← plan-epic's key, and the only key this row carries
pr:       https://github.com/…/pull/1 ← written by the LOOP, by ensureEpicGatePr
waits on: the epic review ticket      — an explicit blocked-by edge onto the gate itself
```

Two things about this row are **derived and never stored**. Its pull request aims at `main`, because the gate
its own id names is itself — `prTarget` is `main` exactly when the owner is the epic gate. And it is the
**epic** tier because its id says so: the kind word between the repo and the uuid is `epic`, which is the only
way the system knows a tier — no edge is walked to work it out.

Every ticket of the tier blocks this gate — that set of blockers **is** the tier, and it is the list the lead
agent reads when it asks whether the epic is proved. What holds the *next* tier off the frontier is an explicit
edge onto the gate itself, and the gate stays open until someone verifies it — so the tower stalls here until a
person, or a lead agent with its tier flag on, closes it. `bd ready` never shows a gate: it is structurally
invisible, so there is nothing to exclude, and the loop claims it by status instead.
"""
      epicE2e = ticket "epic-e2e-test" {
        summary "Journeys across the whole app in a real browser, once every feature gate has closed."
        description """
```
title:    journeys across the whole app in a real browser
id:       box-task-7f3a9c-0.1      ← create-task.sh printed it: the epic's suite is always .1
label:    epic-e2e-test        → AGENT → tester-e2e
metadata: none                     ← the loop reads the uuid off this id and lands on the epic gate for both branches
depends:  blocked-by every feature gate — one edge per feature, written by plan-feature
blocks:   the epic gate (its tier) and the epic review ticket
skill:    framework-playwright
```
**Brief:** state handoffs across the app, session continuity, one success and one failure journey through the
flow. Never re-test the micro tier's edges or the composition tier's wiring. Nothing is assembled for it: the
feature branches are already merged into `epic/record-box`, each by the lead agent standing on its own gate,
which is exactly why this ticket waits on the feature gates and not on a merge row.
"""
      }
      epicReview = ticket "epic-review" {
        summary "The three questions over the whole epic, posted on the epic pull request."
        description """
```
title:    the three questions over the whole epic
id:       box-task-7f3a9c-0.2
label:    epic-review          → AGENT → review
metadata: none                 ← same: its id reaches the epic gate, and the epic gate is its own target
depends:  blocked-by the end-to-end ticket
blocks:   the epic gate (its tier)
```
**Brief:** map entry → exit, instrument with trace logs, run the tests against the instrumented code, post
findings as PR comments. Then the epic gate is verified and closed — by a person, or by the lead agent proving
the tier and merging `epic/record-box` into `main` through the forge.
"""
      }
    }

    featA = gate "Feature gate" {
      summary "One complete flow — a user writes a record and sees it in the box; five tasks, one line."
      description """
```
id:       box-feature-7f3a9c-1     ← the kind word says feature; 1 is this feature's number under the epic
type:     gate
labels:   none — a gate carries zero labels
branch:   feature/add-record           ← plan-feature's key, and the only key this row carries
pr:       https://github.com/…/pull/2  ← written by the Stop hook onto the ticket that first landed work
waits on: the feature review ticket
```

Again nothing here says where its pull request goes: the loop takes this id's uuid, names
`box-epic-7f3a9c-0`, reads `epic/record-box` off that epic gate, and uses it as the **`prTarget`**. Nor is there
any other record of it being a **feature** gate — the kind word in its own id is the whole of the tier test.
One complete user-facing flow: a user writes a record and sees it in the box. Its five tasks are **one linked
line, never a fan**, so the frontier can only ever hand out one task per feature and this branch is never
written by two workers at once. Every one of them blocks this gate, and so do the suite and the review — that
set of blockers is the tier the lead agent proves before it merges `feature/add-record` into `epic/record-box`
through the forge, which is what closing this gate means.
"""
      backendA = ticket "backend-logic" {
        summary "validateRecord and saveRecord as pure functions: the first task, and the only one claimable."
        description """
```
title:    validateRecord + saveRecord — pure functions
label:    backend-logic        → AGENT → engineer
category: backend-logic
id:       box-task-7f3a9c-1.3      ← create-task.sh printed it; a number is a place, not an order
metadata: none                     ← the loop reads both branches off the gates this id names
depends:  none — the first task, and the only ticket claimable when the run starts
blocks:   the feature gate (its tier) and the unit-tests ticket
```
**Requirements**
1. `validateRecord(input): Either<RecordValidationError, Record>` — pure, no mutation
2. `saveRecord(validated)` through the repository port only
3. reject: empty title, title > 120 chars, duplicate slug, missing body

**Files:** `src/records/validate-record.ts`, `src/records/types.ts`, `src/records/ports.ts`
**Done means:** the work committed on the branch, and your result commented on this ticket — the final message is
the live report, the ticket is what outlives the session, and the duty itself is the agent file's
`## Report On The Ticket`, not this description's. The Stop hook files it, not you.
"""
      }
      unitA = ticket "unit-tests" {
        summary "Exhaustive coverage of validateRecord: every branch, every boundary, every error."
        description """
```
title:    exhaustive coverage for validateRecord
label:    unit-tests           → AGENT → tester-unit
category: unit-tests
id:       box-task-7f3a9c-1.4
metadata: none
depends:  blocked-by the back-end ticket — the ticket it tests, its one and only predecessor
blocks:   the feature gate (its tier) and the front-end ticket
skill:    framework-jest
```
**Cover:** every branch, every boundary (120/121 chars), empty and null input, each error it throws, the empty
body.
**Owned elsewhere:** composition wiring (feature tier), components (never here), journeys (epic tier).
"""
      }
      frontendA = ticket "frontend-ui" {
        summary "RecordForm and RecordCard against proved functions; its close unblocks the suite."
        description """
```
title:    RecordForm + RecordCard against proved functions
label:    frontend-ui          → AGENT → frontend
category: frontend-ux          ← the CATEGORY; the LABEL is frontend-ui
id:       box-task-7f3a9c-1.5
metadata: none
depends:  blocked-by the unit tests ticket
blocks:   the feature gate (its tier) and the feature's suite — the tail of the chain hands to it
```
**Brief:** the form, validation feedback surfacing each `RecordValidationError`, the card in the box. Layout and
styling only — the logic is already proved by the micro tier. This ticket landing is what unblocks `feature-test`.
"""
      }
      featureTestA = ticket "feature-test" {
        summary "The add-a-record pieces proved wired, once every task has landed on the branch."
        description """
```
title:    the add-record pieces are wired
label:    feature-test         → AGENT → tester-feature
category: feature-test
id:       box-task-7f3a9c-1.1      ← always .1: a lower number than the tasks it waits on
metadata: none
depends:  blocked-by the front-end ticket — the LAST task; nothing is proved against half a feature
blocks:   the feature gate (its tier) and the feature's review ticket
skill:    framework-playwright
```
**Cover:** the composed flow saves a record; each encapsulated error surfaces to the user.
"""
      }
      featureReviewA = ticket "feature-review" {
        summary "The three questions over feature/add-record; then the human verifies and closes the gate."
        description """
```
title:    the three questions over feature/add-record
label:    feature-review       → AGENT → review
category: review
id:       box-task-7f3a9c-1.2
metadata: none
depends:  blocked-by the feature's suite — no review before the suite
blocks:   the feature gate (its tier)
```
**Brief:** three questions from first principles, findings as PR comments. Then the feature gate is verified and
closed — by a person, or by the lead agent proving the tier and merging `feature/add-record` into
`epic/record-box` with `gh pr merge` / `glab mr merge` on that PR.
"""
      }
    }
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // THE ALARMS — every reason string in the engine and the Stop hook, and what
  // happens to the ticket when it fires. All of them are walked in views.c4.
  // ═════════════════════════════════════════════════════════════════════════════

  alarms = layer "Alarms — every reason= in the code" {
    summary "Every reason the engine and the Stop hook can log, and what happens to the ticket."

    startupAlarms = layer "raised before the first tick — the run never starts" {
      summary "The alarms that refuse the run before its first tick."
      toolsMissing = alarm "startup: <tool> not found on PATH" {
        #fatal
        summary "A tool the loop needs is not on PATH, so the run exits before its first tick."
      }
      knobNotNumeric = alarm "startup: SF_<VAR>=<x> is not a number" {
        #fatal
        summary "A numeric knob was set to something that is not a number, so the run refuses to start."
      }
      gateFlagNotASwitch = alarm "startup: SF_AGENT_<TIER>_GATES=<x> is not a switch" {
        #fatal
        summary "A gate tier switch is neither 0 nor 1, so the run refuses to guess who closes that tier's gate."
      }
      pollUnusable = alarm "startup: SF_POLL_S=<x> is unusable — it must divide 60" {
        #fatal
        summary "The poll interval does not divide 60, so the waiting-line cadence would be a lie."
      }
      noBeadsDb = alarm "startup: no beads database found from $PWD" {
        #fatal
        summary "This directory answers no ticket list, so nothing can be done here."
      }
      logDirUnwritable = alarm "startup: cannot create <dir>" {
        #fatal
        summary "The run's log directory cannot be created, so the run could never raise an alarm."
      }
      agentDefinitionMissing = alarm "startup: no agent named '<name>'" {
        #fatal
        summary "An agent in the worker set has no file, or a file with no usable frontmatter. The run exits before its first tick."
      }
      labelsStarved = alarm "not fatal: SF_ALLOWED_LABELS names nothing the map holds" {
        #fatal
        summary "The allowed labels name nothing the map holds: not fatal, but the tower never moves."
      }
    }

    tickAlarms = layer "raised by the tick" {
      summary "Everything the tick can refuse, and whether the ticket stays claimed."
      bdFailure = alarm "ERROR reason=bd-failure exit=N" {
        summary "The claim failed or answered without an id; the tick returns and the next one tries again."
      }
      labelAmbiguous = alarm "ERROR reason=label-ambiguous" {
        #leftClaimed
        summary "Zero or two dispatching labels on the claim; the loop never guesses a worker."
      }
      noEpicGate = alarm "ERROR reason=no-epic-gate ticket=<id>" {
        #leftClaimed
        summary "The ticket's id reaches no gate: it belongs to no tower. The id is in the line."
      }
      ticketGateUnworkable = alarm "ERROR reason=gate-unworkable ticket=<id>" {
        #leftClaimed
        summary "The ticket's id reaches its gates, but one of them carries no branch."
      }
      epicPrFailed = alarm "ERROR reason=epic-pr-failed step=…" {
        #unclaimed
        summary "The epic branch or its pull request could not be published; seven steps say where."
      }
      worktreeFailed = alarm "ERROR reason=worktree-failed step=…" {
        #leftClaimed
        summary "The branch's folder could not be built, so no worker is spawned into it; four steps say where."
      }
      branchHasUnpushed = alarm "ERROR reason=branch-has-unpushed-commits" {
        #leftClaimed
        summary "The local branch holds commits no remote has seen; the loop refuses to reset a branch that does."
      }
      folderMovedAside = alarm "ERROR reason=worktree-folder-moved-aside" {
        #staysClaimed
        summary "Not a refusal: an interrupted build's files were kept under a .stale-<epoch> name and the build went ahead."
      }
      workerNotDispatched = alarm "ERROR reason=worker-not-dispatched" {
        #unclaimed
        summary "The spawn came back failed; the one alarm that puts the ticket straight back."
      }
      agentNotLoaded = alarm "ERROR reason=agent-not-loaded" {
        #unclaimed
        summary "The session came up but never proved itself the agent it named: the claim goes back and the run dies."
      }
      gateClaimLost = alarm "ERROR reason=gate-claim-lost gate=<id>" {
        #idle
        summary "The gate was no longer open the moment the loop reached for it; no lead agent was spawned."
      }
    }

    stopAlarms = layer "raised by the Stop hook — fail-closed, in code order" {
      summary "Everything the Stop hook refuses, in code order: fail-closed, ticket untouched."
      claimMalformedHook = alarm "ERROR reason=claim-malformed" {
        #staysClaimed
        summary "The session's claims line carries no ticket or no run, so the hook cannot tell what it stands for."
      }
      noContextHook = alarm "ERROR reason=no-context worktree=<dir>" {
        #staysClaimed
        summary "A worker stopped in a loop worktree with no dispatch context file and no branch or target to fall back on."
      }
      missingToolHook = alarm "ERROR reason=missing-tool tool=<t>" {
        #staysClaimed
        summary "bd, jq, git or sf is missing; checked before any of the hook's own work, once the session is known."
      }
      noWorktreeHook = alarm "ERROR reason=no-worktree" {
        #staysClaimed
        summary "The claims line names no worktree that exists, and the hook will not guess one off the hook input's cwd."
      }
      workerNeedsInput = alarm "ERROR reason=worker-needs-input needs=\"…\"" {
        #staysClaimed
        summary "The session stopped to ask a question, so nothing landed: the ticket stays claimed until someone answers it."
      }
      workerFailed = alarm "ERROR reason=worker-failed | reason=worker-stopped" {
        #staysClaimed
        summary "The session ended in state=failed or state=stopped, which is not a finished turn."
      }
      sessionVerdictUnknown = alarm "ERROR reason=session-verdict-unknown verdict=<v>" {
        #staysClaimed
        summary "The hook cannot read the session's verdict, and a verdict it cannot read is never a verdict it guesses at."
      }
      ticketNotInWork = alarm "ERROR reason=ticket-not-in-work state=<s>" {
        #staysClaimed
        summary "The ticket is not in progress; if it is closed, this is a second Stop and the hook leaves."
      }
      noBranchHook = alarm "ERROR reason=no-branch" {
        #staysClaimed
        summary "The dispatch record carries no branch, so the hook refuses to file work anywhere."
      }
      noPrTarget = alarm "ERROR reason=no-pr-target" {
        #staysClaimed
        summary "The dispatch record carries no pull-request target, so the hook refuses to aim blind."
      }
      wrongBranch = alarm "ERROR reason=wrong-branch want=<b> got=<d>" {
        #staysClaimed
        summary "The worker changed branch anyway, so the hook will not file its work under this ticket."
      }
      noTitle = alarm "ERROR reason=ticket-has-no-title" {
        #staysClaimed
        summary "The commit message is the ticket title, and a titleless ticket cannot be filed."
      }
      commitFailed = alarm "ERROR reason=commit-failed" {
        #staysClaimed
        summary "Committing the tree failed — a genuinely empty tree is allowed, this is not one."
      }
      pushFailed = alarm "ERROR reason=push-failed" {
        #staysClaimed
        summary "Pushing the branch to the remote failed; its output is quoted on the line."
      }
      forgeUnknown = alarm "ERROR reason=forge-unknown remote=<url>" {
        #staysClaimed
        summary "Nothing settled which forge this remote is, and the hook refuses to guess."
      }
      forgeToolMissing = alarm "ERROR reason=missing-tool tool=gh|glab forge=<f>" {
        #staysClaimed
        summary "The forge is known, but its command line tool is not installed."
      }
      prNotFoundGate = alarm "ERROR reason=pr-not-found forge=<f>" {
        #staysClaimed
        summary "The lead agent stopped on a gate whose branch has no pull request at all — the gate path's own refusal."
      }
      prNotCreated = alarm "ERROR reason=pr-not-created forge=<f>" {
        #staysClaimed
        summary "Nothing came back that looks like a pull request url."
      }
      ticketNotAnnotated = alarm "ERROR reason=ticket-not-annotated pr=<url>" {
        #staysClaimed
        summary "Writing the pull request url onto the ticket failed, so the hook will not close it."
      }
      closeFailed = alarm "ERROR reason=close-failed pr=<url>" {
        #staysClaimed
        summary "The final close failed: the work is out there with no record in the tower."
      }
    }

  }

  waiting = layer "Waiting lines — nothing failed, nothing ran (one a minute per reason)" {
    summary "The quiet ticks: nothing failed, nothing ran, one line a minute per reason."
    frontierEmpty = waitingLine "reason=frontier_empty" {
      #idle
      summary "Nothing waits anywhere: the tower is finished or unplanned. The calm one."
    }
    towerStalled = waitingLine "reason=tower_stalled waiting=N" {
      #idle
      summary "Work exists but a blocker holds it off the frontier — usually a gate whose tier is still a person's."
    }
    gateUnworkable = waitingLine "reason=gate_unworkable gate=<id> step=<why>" {
      #idle
      summary "A ready gate's id reaches no usable branch and target, so no lead agent can be placed or aimed."
    }
    maxParallel = waitingLine "reason=max_parallel in_progress=N" {
      #idle
      summary "The cap is reached and tickets are in progress, so this tick claims nothing."
    }
    maxParallelStalled = waitingLine "reason=max_parallel_stalled in_progress=0" {
      #idle
      summary "At capacity with nothing in progress: the counted workers are ghosts."
    }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // The depends-on edges, as edges of the model rather than of one walkthrough.
  // A static view draws only these; a dynamic view draws only the edges its own
  // steps create — so the graph view needs them here. The edges that make a TIER
  // are absent, every one of them: each row blocks its own gate, and a gate is
  // drawn as the box around its tier's rows, so the engine refuses those edges as
  // parent-child. The gate's own panel is the list of its blockers.
  // ═══════════════════════════════════════════════════════════════════════════

  tower.featA.backendA -[blocks]-> tower.featA.unitA "then its tests"
  tower.featA.unitA -[blocks]-> tower.featA.frontendA "then the interface"
  tower.featA.frontendA -[blocks]-> tower.featA.featureTestA "then the suite"
  tower.featA.featureTestA -[blocks]-> tower.featA.featureReviewA "then the review"

  tower.featA -[blocks]-> tower.epic.epicE2e "no journey over an unmerged flow"
  tower.epic.epicE2e -[blocks]-> tower.epic.epicReview "the journeys, then the review"
}
