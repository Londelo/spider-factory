views {

  // ═════════════════════════════════════════════════════════════════════════════
  // Four walkthroughs and nothing else. Every node on a page is either pointed at
  // by a step or sits inside a box a step points at.
  //   1 · the plan     — a person turns an idea into nine tickets
  //   2 · the run      — the installer puts `sf` on your path, then ticket after ticket
  //   3 · the log      — what a run writes and how to read a stuck tower
  //   4 · the failures — the same run with every alarm firing
  // A step here is its arrow words, its title, and nothing else. **A step carries no `notes` block — never
  // add one back.** What a thing *is*, and every command, table and rule behind it, lives in that node's own
  // description in model.c4 — click the node, not the step. Rules for editing these files:
  // ./REFERENCE.md — the code is the only source of truth.
  // ═════════════════════════════════════════════════════════════════════════════

  // ────────────────────────────────────────────────────────────────────────────
  // 1 · THE PLANNING PHASE
  // ────────────────────────────────────────────────────────────────────────────

  dynamic view index {
    title "Spider Factory/Walkthrough/1 · The planning phase — a vague idea becomes nine tickets"

    include human, planAgents, planAgents.*, beads
    include tower, tower.epic, tower.epic.epicE2e, tower.epic.epicReview
    include tower.featA, tower.featA.backendA, tower.featA.unitA, tower.featA.frontendA
    include tower.featA.featureTestA, tower.featA.featureReviewA

    // ═ ACT I — the planning session: three conversations, and every row they write

    human -> planAgents.planEpic "a vague idea: I want somewhere to keep my records" {
      title "You describe the idea; the planner asks questions and settles it"
    }

    planAgents.planEpic -[plans]-> tower.epic "the epic gate — the gate, written first" {
      title "The one row that carries the epic's branch name"
    }

    planAgents.planEpic -[plans]-> tower.epic.epicE2e "the end-to-end ticket — journeys in a real browser" {
      title "The broad tier of the test system"
    }

    planAgents.planEpic -[plans]-> tower.epic.epicReview "the epic review ticket — the three questions" {
      title "The epic's review — what you wait for before the tier is proved"
    }

    human -> planAgents.planFeature "break the epic into features" {
      title "One epic in, its features out — this epic needs only one"
    }

    planAgents.planFeature -[plans]-> tower.featA "the feature gate — the gate, and its branch" {
      title "The one row that carries feature/add-record"
    }

    planAgents.planFeature -[plans]-> tower.featA.featureTestA "the feature's suite — the composition tier" {
      title "The feature's suite, written before any of its tasks exist"
    }

    planAgents.planFeature -[plans]-> tower.featA.featureReviewA "the feature review ticket — the three questions" {
      title "The feature's review, over its own branch"
    }

    human -> planAgents.planTask "break this one feature into tasks" {
      title "One feature in, its chain of tasks out"
    }

    planAgents.planTask -[plans]-> tower.featA.backendA "the back-end ticket — the logic" {
      title "The head of the chain, and the only row claimable"
    }

    planAgents.planTask -[plans]-> tower.featA.unitA "the unit tests ticket — its tests, every case" {
      title "The micro tier follows the back-end row it tests, never a component"
    }

    planAgents.planTask -[plans]-> tower.featA.frontendA "the front-end ticket — the interface" {
      title "Built last, against functions already proved"
    }

    // ═ ACT II — the graph they left behind: the edges that run between two rows, the agent
    //   that wrote each, and the edge every single row has onto its own gate. That last set is
    //   the tier: nothing else in the database records which gate a row belongs to.

    tower.featA.backendA -[blocks]-> tower.featA.unitA "the logic, then its tests" {
      title "Written by plan-task — no test runs against a function nobody has written"
    }

    tower.featA.unitA -[blocks]-> tower.featA.frontendA "the tests, then the interface" {
      title "Written by plan-task — the interface is built against functions already proved"
    }

    tower.featA.frontendA -[blocks]-> tower.featA.featureTestA "the last task releases the suite" {
      title "Written by plan-task — nothing is proved against half a feature"
    }

    tower.featA.featureTestA -[blocks]-> tower.featA.featureReviewA "the suite, then the review" {
      title "Written by plan-feature — no review before the suite"
    }

    tower.featA -[blocks]-> tower.epic.epicE2e "no journey over an unmerged flow" {
      title "Written by plan-feature — the one edge only it can write"
    }

    tower.epic.epicE2e -[blocks]-> tower.epic.epicReview "the journeys, then the review" {
      title "Written by plan-epic — no review before the journeys"
    }

    // ═ ACT III — the tower is standing, and only one row can be claimed

    human -> beads "bd list — all nine are in the tower" {
      title "Nine tickets in the database, and only one can be claimed"
      navigateTo theLoop
    }

    autoLayout LeftRight
  }

  // ────────────────────────────────────────────────────────────────────────────
  // 2 · INSTALLING THE CLI AND RUNNING THE LOOP
  // ────────────────────────────────────────────────────────────────────────────

  dynamic view theLoop {
    title "Spider Factory/Walkthrough/2 · The run — the CLI installed, then ticket after ticket"

    include
      human,
      machine,
      machine.sfCli,
      machine.installer,
      machine.websCloner,
      machine.knobs,
      machine.preflight,
      machine.dispatcher,
      machine.agentMap,
      machine.hookFields,
      machine.claim,
      beads,
      tower.*,
      toolbelt,
      toolbelt.worktree,
      toolbelt.gitCli,
      toolbelt.forgeCli,
      toolbelt.claudeCli,
      forge,
      workers,
      workers.engineer,
      workers.testerUnit,
      workers.frontend,
      workers.testerFeature,
      workers.testerE2e,
      workers.reviewAgent,
      workers.leadAgent,
      stopHook,
      waiting,
      waiting.towerStalled

    // ═ ACT I — setup, once per machine: the installer, the command, the webs, the settings, the checks

    human -> machine.installer "bash CLI/install-cli.sh · put sf on your path" {
      title "You run the installer yourself — once per machine"
    }

    human -> machine.sfCli "sf · eight commands, each one an engine under CLI/src/" {
      title "One command is the whole door in, and it refuses to answer from anywhere but the factory"
    }

    human -> machine.websCloner "npm run webs:clone · the repos the workers build" {
      title "The webs themselves, once per machine, before any tower means anything"
    }

    machine.knobs -> machine.dispatcher "claude · 4 parallel · 3 s · logs under ~/.spider-factory · labels *" {
      title "Read once at startup, and all of it CLI-side — a worker session is handed none of it"
    }

    machine.dispatcher -> machine.preflight "before the first tick: eight checks" {
      title "Eight checks, and seven of them stop the run"
      navigateTo everyFailure
    }

    // ═ ACT II — one ticket, end to end

    machine.dispatcher -> beads "what is ready?" {
      title "The database is the only thing the loop reads for its plan — no design doc, no CLAUDE.md"
    }

    machine.dispatcher -> machine.claim "round 1 — take one ticket" {
      title "Count what is already running, then take one ticket"
    }

    machine.claim -> tower.featA.backendA "the back-end ticket" {
      title "The ticket says who does it and where it lands"
    }

    machine.dispatcher -> tower.epic "the epic gate is the ticket's own id with its kind word swapped" {
      title "The epic gate is the ticket's own id, re-kinded — never walked to, never searched for"
    }

    machine.dispatcher -> toolbelt.forgeCli "publish the epic branch and its pull request, once" {
      title "If the epic has no pull request yet, make one before anyone works"
    }

    toolbelt.forgeCli -> forge "PR 1 — epic/record-box into main" {
      title "Pull request 1: the epic branch into main"
    }

    machine.dispatcher -> toolbelt.worktree "make the branch's folder" {
      title "One folder per branch, never per ticket — every ticket of the feature works in it in turn"
    }

    machine.dispatcher -> machine.agentMap "backend-logic means engineer" {
      title "Exactly one dispatching label picks one worker — two or none and the ticket is left claimed"
    }

    machine.dispatcher -> toolbelt.claudeCli "start the worker in that folder" {
      title "Only spawn.sh starts a session, and only through the launch command that adds the factory root"
    }

    machine.dispatcher -> machine.hookFields "write the dispatch down instead of exporting it" {
      title "The worker is handed no environment; the record is what carries it"
    }

    machine.dispatcher -> toolbelt.claudeCli "prove the session came up as that agent" {
      title "A worker with no agent does not fail, so the spawn is checked"
      navigateTo everyFailure
    }

    toolbelt.claudeCli -> workers.engineer "the rules arrive with the brief" {
      title "The worker's prompt is four rules and an order to read its ticket"
    }

    workers.engineer -> tower.featA.backendA "write the code" {
      title "The engineer writes the code and leaves the ticket open"
    }

    workers.engineer -> stopHook "stop" {
      title "The worker stops, and stopping is the whole signal that its turn is over"
    }

    stopHook -> toolbelt.gitCli "sf commit, then push — once the dispatch is on the claims line" {
      title "Only a session the harness reports done lands work — any other verdict leaves the ticket claimed"
    }

    stopHook -> toolbelt.forgeCli "the pull request for this branch" {
      title "One branch, one pull request, forever"
    }

    toolbelt.forgeCli -> forge "PR 2 — feature/add-record into epic/record-box" {
      title "Pull request 2: the feature branch into the epic branch"
    }

    stopHook -> beads "write the url, then close" {
      title "Write the url first, close second"
      navigateTo everyFailure
    }

    // ═ ACT III — the same loop, six more tickets, three steps each

    machine.dispatcher -> machine.claim "the rounds — six more tickets" {
      title "What the first loop showed, six more times, said three ways"
    }

    // ── the unit tests ticket — the tests for the back-end logic

    machine.claim -> tower.featA.unitA "then we pick up the unit tests ticket" {
      title "The tests for the logic just written"
    }

    tower.featA.unitA -> workers.testerUnit "that ticket is handled by the unit tester" {
      title "One label, one worker"
    }

    workers.testerUnit -> tower.featA.unitA "the unit tester tests validateRecord alone" {
      title "Every branch, every boundary, every error"
    }

    // ── the front-end ticket — the feature's interface

    machine.claim -> tower.featA.frontendA "then we pick up the front-end ticket" {
      title "The last ticket in the feature's chain"
    }

    tower.featA.frontendA -> workers.frontend "that ticket is handled by the front-end worker" {
      title "One label, one worker"
    }

    workers.frontend -> tower.featA.frontendA "the front-end worker builds the add-a-record form" {
      title "One ticket, styling included"
    }

    // ── the feature's suite — is the feature wired together?

    machine.claim -> tower.featA.featureTestA "then we pick up the feature's suite" {
      title "Nothing is proved against half a feature"
    }

    tower.featA.featureTestA -> workers.testerFeature "that ticket is handled by the feature tester" {
      title "One label, one worker"
    }

    workers.testerFeature -> tower.featA.featureTestA "the feature tester drives the add flow in a browser" {
      title "One case per path, nothing repeated"
    }

    // ── the feature review ticket — review the feature

    machine.claim -> tower.featA.featureReviewA "then we pick up the feature's review ticket" {
      title "The review of the finished branch"
    }

    tower.featA.featureReviewA -> workers.reviewAgent "that ticket is handled by the reviewer" {
      title "One label, one worker"
    }

    workers.reviewAgent -> tower.featA.featureReviewA "the reviewer reviews the branch, findings on PR 2" {
      title "What it writes is what you read before closing"
      navigateTo theLogs
    }

    workers.reviewAgent -> workers.engineer "each finding goes once to the agent that owns that kind of fix" {
      title "One round of fixers, then review stops looking"
    }

    // ═ ACT IV — the tower stops, and with both switches off only a person can start it again

    machine.dispatcher -> waiting.towerStalled "nothing left to claim" {
      title "The work is done and the loop does not know it"
      navigateTo everyFailure
    }

    human -> tower.featA "read PR 2, close the feature gate" {
      title "You read pull request 2 and close the gate"
    }

    // ═ ACT V — the same gate with its switch on: the loop sends its own worker

    machine.knobs -> machine.dispatcher "SF_AGENT_FEATURE_GATES=1" {
      title "One switch hands one tier to the lead agent"
    }

    machine.dispatcher -> beads "which gates are ready?" {
      title "A gate is listed, never claimed off the frontier"
    }

    machine.dispatcher -> workers.leadAgent "the gate dispatch spawns the lead agent" {
      title "The one worker no label reaches"
    }

    workers.leadAgent -> tower.featA "the lead agent proves the tier" {
      title "A closed ticket is a claim, not a fact"
    }

    workers.leadAgent -> toolbelt.forgeCli "merge it, through the forge" {
      title "`gh pr merge` / `glab mr merge`, into the gate's prTarget"
    }

    toolbelt.forgeCli -> forge "PR 2 merged into epic/record-box" {
      title "The feature is now in the epic branch"
    }

    workers.leadAgent -> stopHook "stop" {
      title "The hook closes the gate, and opens no pull request"
    }

    // ── the end-to-end ticket — the whole flow in a real browser

    machine.claim -> tower.epic.epicE2e "then we pick up the end-to-end ticket" {
      title "The broad tier's single ticket"
    }

    tower.epic.epicE2e -> workers.testerE2e "that ticket is handled by the end-to-end tester" {
      title "The widest tier"
    }

    workers.testerE2e -> tower.epic.epicE2e "the end-to-end tester walks the whole flow in a browser" {
      title "Write a record, then find it in the box"
    }

    // ── the epic review ticket — review the epic

    machine.claim -> tower.epic.epicReview "then we pick up the epic's review ticket" {
      title "The last ticket the loop ever claims"
    }

    tower.epic.epicReview -> workers.reviewAgent "that ticket is handled by the reviewer" {
      title "The same worker as the feature review"
    }

    workers.reviewAgent -> tower.epic.epicReview "the reviewer reviews the epic, findings on PR 1" {
      title "The whole epic at once, findings on the epic's pull request"
    }

    human -> tower.epic "close the epic gate" {
      title "You close the epic gate, and the tower is finished"
      navigateTo theLogs
    }

    autoLayout LeftRight
  }

  // ────────────────────────────────────────────────────────────────────────────
  // 3 · THE RUN LOG
  // ────────────────────────────────────────────────────────────────────────────

  dynamic view theLogs {
    title "Spider Factory/Walkthrough/3 · The run log — who writes what, and how to read a tower that is not moving"

    include human, machine.dispatcher, beads, workers.engineer, stopHook, overseerAgent, towerView, logRun, logRun.*

    // ═ ACT I — one directory per run, and one line format that never varies

    machine.dispatcher -> logRun "one directory per run, made before the first tick" {
      title "One folder per run, with its five files made up front"
      navigateTo theLoop
    }

    // ═ ACT II — the writers, one file each

    machine.dispatcher -> logRun.fClaims "CLAIMS" {
      title "Every ticket taken, every gate taken, and the epic branch published"
    }

    machine.dispatcher -> logRun "and one file per branch, beside the run folders, not inside one" {
      title "The dispatch record is the only state that is neither the database nor a log line"
    }

    machine.dispatcher -> logRun.fWaiting "WAITING" {
      title "The quiet ticks: alive, with nothing to do"
      navigateTo everyFailure
    }

    machine.dispatcher -> logRun.fErrors "ERRORS" {
      title "Every alarm the loop saw, never capped"
      navigateTo everyFailure
    }

    machine.dispatcher -> logRun.fBdStderr "bd-stderr" {
      title "The ticket tool's own complaint, kept separate"
    }

    machine.dispatcher -> logRun.fClaudeStderr "claude-stderr" {
      title "What the session counter said when it failed"
    }

    machine.dispatcher -> logRun.fSpawn "spawn-<ticket>" {
      title "One file per worker: its session id is read back out of here, and its last line is what a failed launch quotes"
    }

    machine.dispatcher -> logRun "one tick, the three files it touches" {
      title "One ticket's whole life is three files: claims, its own spawn file, and closes"
    }

    stopHook -> logRun.fCloses "CLOSES" {
      title "Proof of work, written last"
    }

    machine.dispatcher -> logRun.fResults "RESULTS" {
      title "Ticks, claims, and tickets closed — the done count is lines in the closes file, not ticks"
    }

    // ═ ACT III — reading a tower that is not moving

    human -> logRun "the four files, in this order" {
      title "How to read a tower that is not moving: claims, waiting, errors, results — newest run first"
      navigateTo everyFailure
    }

    human -> overseerAgent "how's the tower going?" {
      title "Or ask the reader instead of reading the files yourself"
    }

    overseerAgent -> beads "reads the tower, never writes it" {
      title "Where the fix is a mutation, it hands you the command"
    }

    human -> towerView "sf tower · or see the whole tower at once" {
      title "Or ask the database for a picture instead of a report"
    }

    towerView -> beads "two reads, and the database never notices" {
      title "The other reader: no logs, no git, no session"
    }

    beads -> logRun "and the log is not the state" {
      title "The database is the truth; the log is the testimony"
      navigateTo index
    }

    autoLayout LeftRight
  }

  // ────────────────────────────────────────────────────────────────────────────
  // 4 · EVERY FAILURE
  // ────────────────────────────────────────────────────────────────────────────

  dynamic view everyFailure {
    title "Spider Factory/Walkthrough/4 · Every failure — the same tower with every alarm firing"

    include
      human,
      machine.dispatcher,
      beads,
      stopHook,
      logRun.fErrors,
      alarms,
      alarms.startupAlarms,
      alarms.startupAlarms.*,
      alarms.tickAlarms,
      alarms.tickAlarms.*,
      alarms.stopAlarms,
      alarms.stopAlarms.*,
      waiting,
      waiting.*

    // ═ PART A — the run never starts

    machine.dispatcher -> alarms.startupAlarms.toolsMissing "bd jq git + the agent command — <tool> not found · exit 1" {
      title "A tool is missing, and the run will not start"
    }

    machine.dispatcher -> alarms.startupAlarms.knobNotNumeric "SF_MAX_PARALLEL=four is not a number · exit 1" {
      title "A setting is not a number, and the run will not start"
    }

    machine.dispatcher -> alarms.startupAlarms.gateFlagNotASwitch "SF_AGENT_FEATURE_GATES=true is not a switch · exit 1" {
      title "A gate tier is neither a person's nor a machine's, and the run will not start"
      navigateTo index
    }

    machine.dispatcher -> alarms.startupAlarms.pollUnusable "SF_POLL_S=7 is unusable · exit 1" {
      title "The poll interval cannot work, and the run will not start"
    }

    machine.dispatcher -> alarms.startupAlarms.noBeadsDb "no ticket database found from here · exit 1" {
      title "No ticket database here, and the run will not start"
    }

    machine.dispatcher -> alarms.startupAlarms.logDirUnwritable "cannot write the log folder · exit 1" {
      title "The log folder cannot be written, and the run will not start"
    }

    machine.dispatcher -> alarms.startupAlarms.agentDefinitionMissing "no agent named 'engineer' · exit 1" {
      title "A worker the map can name has no agent file, and the run will not start"
    }

    machine.dispatcher -> alarms.startupAlarms.labelsStarved "SF_ALLOWED_LABELS=<typo> — the run starts and does nothing" {
      title "The one startup mistake that does NOT stop the run"
    }

    // ═ PART B — the tick fails, and the ticket's fate is the interesting part

    machine.dispatcher -> alarms.tickAlarms.gateClaimLost "ERROR reason=gate-claim-lost gate=<id> · no lead agent spawned" {
      title "The gate dispatch comes first, and it is the only claim that can be lost"
      navigateTo index
    }

    machine.dispatcher -> alarms.tickAlarms.bdFailure "ERROR reason=bd-failure exit=2" {
      title "The claim command itself failed"
    }

    machine.dispatcher -> beads "empty claim — check whether blocked work exists" {
      title "An empty claim is two opposite situations"
      navigateTo index
    }

    machine.dispatcher -> alarms.tickAlarms.labelAmbiguous "ERROR reason=label-ambiguous · LEFT CLAIMED" {
      title "The label names no worker, or two"
      navigateTo index
    }

    machine.dispatcher -> alarms.tickAlarms.noEpicGate "ERROR reason=no-epic-gate ticket=<id> · LEFT CLAIMED" {
      title "The ticket's id reaches no gate"
      navigateTo index
    }

    machine.dispatcher -> alarms.tickAlarms.ticketGateUnworkable "ERROR reason=gate-unworkable ticket=<id> · LEFT CLAIMED" {
      title "Its gates exist, but one carries no branch"
      navigateTo index
    }

    machine.dispatcher -> alarms.tickAlarms.epicPrFailed "ERROR reason=epic-pr-failed step=push · UNCLAIMED" {
      title "The epic's branch or pull request could not be published"
    }

    machine.dispatcher -> alarms.tickAlarms.worktreeFailed "ERROR reason=worktree-failed step=… · LEFT CLAIMED" {
      title "The branch's folder could not be made"
    }

    machine.dispatcher -> alarms.tickAlarms.branchHasUnpushed "ERROR reason=branch-has-unpushed-commits · LEFT CLAIMED" {
      title "The branch holds work no remote has ever seen, so the loop will not reset it"
    }

    machine.dispatcher -> alarms.tickAlarms.folderMovedAside "ERROR reason=worktree-folder-moved-aside · the worker still starts" {
      title "A dead build's folder was kept, not overwritten"
    }

    machine.dispatcher -> alarms.tickAlarms.workerNotDispatched "ERROR reason=worker-not-dispatched · put it back" {
      title "The worker never started, so the ticket goes straight back"
    }

    machine.dispatcher -> alarms.tickAlarms.agentNotLoaded "ERROR reason=agent-not-loaded · put it back, then the run dies" {
      title "The session started, but never proved itself the agent it named"
    }

    // ═ PART C — the Stop hook's guards, in the order the file runs them.
    //   The count is deliberately not written here: it is a claim about a line count
    //   and it goes stale the moment a guard is added. Read the order, not a number.

    stopHook -> alarms.stopAlarms.claimMalformedHook "ERROR reason=claim-malformed" {
      title "First guard: this session's claims line is not a line it can parse"
    }

    stopHook -> alarms.stopAlarms.noContextHook "ERROR reason=no-context worktree=<dir>" {
      title "No dispatched claims line for this session id — a human's session, and it writes nothing"
    }

    stopHook -> alarms.stopAlarms.missingToolHook "ERROR reason=missing-tool tool=git" {
      title "bd, jq, git or sf is not on PATH · the ticket stays claimed"
    }

    stopHook -> alarms.stopAlarms.noWorktreeHook "ERROR reason=no-worktree" {
      title "The claims line names no worktree that exists, and it will not guess one off the cwd"
    }

    stopHook -> alarms.stopAlarms.workerNeedsInput "ERROR reason=worker-needs-input needs=\"…\"" {
      title "The session stopped to ask a question, so nothing lands until someone answers it"
    }

    stopHook -> alarms.stopAlarms.workerFailed "ERROR reason=worker-failed | reason=worker-stopped" {
      title "The session ended in failed or stopped, which is not a finished turn"
    }

    stopHook -> alarms.stopAlarms.sessionVerdictUnknown "ERROR reason=session-verdict-unknown verdict=no-record" {
      title "It cannot read the verdict, and a verdict it cannot read is never a verdict it guesses at"
    }

    stopHook -> alarms.stopAlarms.ticketNotInWork "ERROR reason=ticket-not-in-work state=open" {
      title "Not in progress · and silent when the ticket is already closed, so a second Stop lands nothing twice"
    }

    stopHook -> alarms.stopAlarms.noBranchHook "ERROR reason=no-branch" {
      title "Neither the claims line nor the context file names a branch — the record is the only place one was written"
    }

    stopHook -> alarms.stopAlarms.noPrTarget "ERROR reason=no-pr-target" {
      title "Neither the claims line nor the context file names a pull-request target, so the hook would be aiming blind"
    }

    stopHook -> alarms.stopAlarms.wrongBranch "ERROR reason=wrong-branch want=feature/add-record" {
      title "The worktree is not on the branch the ticket belongs to"
    }

    stopHook -> alarms.stopAlarms.noTitle "ERROR reason=ticket-has-no-title" {
      title "No title, so there is no commit subject"
    }

    stopHook -> alarms.stopAlarms.commitFailed "ERROR reason=commit-failed" {
      title "sf commit returned non-zero · and an empty tree is NOT this"
    }

    stopHook -> alarms.stopAlarms.pushFailed "ERROR reason=push-failed" {
      title "The commit is local only, so the PR would show nothing"
    }

    stopHook -> alarms.stopAlarms.forgeUnknown "ERROR reason=forge-unknown remote=<url>" {
      title "Reached only after the commit and the push: the remote names neither forge"
    }

    stopHook -> alarms.stopAlarms.forgeToolMissing "ERROR reason=missing-tool tool=gh forge=github" {
      title "The forge settled, but its CLI — gh or glab — is not on PATH"
    }

    stopHook -> alarms.stopAlarms.prNotFoundGate "ERROR reason=pr-not-found forge=github" {
      title "The gate path's own refusal: a gate never opens a PR, so it can only find one"
    }

    stopHook -> alarms.stopAlarms.prNotCreated "ERROR reason=pr-not-created forge=github" {
      title "The task path's own refusal: the work is committed and pushed, no PR exists"
    }

    stopHook -> alarms.stopAlarms.ticketNotAnnotated "ERROR reason=ticket-not-annotated pr=<url>" {
      title "The work is out there and the ticket cannot say where"
    }

    stopHook -> alarms.stopAlarms.closeFailed "ERROR reason=close-failed pr=<url>" {
      title "Everything else already succeeded, and the ticket is still open"
    }

    // ═ PART D — not failures: the ticks that had nothing to dispatch

    machine.dispatcher -> waiting.maxParallel "WAITING … reason=max_parallel in_progress=4" {
      title "Four workers running, so this tick claims nothing"
    }

    machine.dispatcher -> waiting.maxParallelStalled "WAITING … reason=max_parallel_stalled in_progress=0" {
      title "Full, with nothing in progress: the slots are ghosts"
    }

    machine.dispatcher -> waiting.gateUnworkable "WAITING … reason=gate_unworkable gate=<id> step=<why>" {
      title "A ready gate's id reaches no branch, or no target"
      navigateTo index
    }

    machine.dispatcher -> waiting.frontierEmpty "WAITING … reason=frontier_empty" {
      title "The calm one: finished, or never planned"
      navigateTo index
    }

    machine.dispatcher -> waiting.towerStalled "WAITING … reason=tower_stalled waiting=2" {
      title "Work exists and something is holding it — usually an open gate"
      navigateTo index
    }

    // ═ PART E — where all of it lands

    machine.dispatcher -> logRun.fErrors "ERROR … never rate-limited" {
      title "Every alarm lands in one file, whoever saw it"
      navigateTo theLogs
    }

    human -> beads "and every one of these is a person's call" {
      title "None of these fix themselves"
      navigateTo index
    }

    autoLayout LeftRight
  }
}
