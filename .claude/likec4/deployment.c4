deployment {

  // Where the work physically happens: one folder per BRANCH, never per ticket.
  // `.claude/worktrees/<branch with / → +>` — the loop makes it for the branch's
  // first task and every later task re-enters it.

  towerRoot = worktreeBox "<tower> — the tower root, where .beads lives" {
    description '''
**What it is:** the checkout you ran `bo loop` from. It owns the beads DB and the `.claude/worktrees/`
folder; no worker ever works here, and `BO_PROJECT_DIR` points back at it. Capacity is counted as the
background sessions under this directory plus this directory itself.
'''

    wtEpic = worktreeBox "epic+recipe-box → epic/recipe-box" {
      description '''
**What it is:** the epic branch's worktree, where the epic tier runs. `ensureWorktree` starts it at
`origin/epic/recipe-box` if someone pushed one, otherwise at the epic gate's own base. The loop alone
publishes this branch and its PR into `main`, and writes the url onto the gate as `pr`.
'''
      mergeRun = instanceOf workers.mergeAgent
      e2eRun = instanceOf workers.testerE2e
      epicReviewRun = instanceOf workers.reviewAgent
      tMerge = instanceOf tower.epic.epicMergePr
      tE2e = instanceOf tower.epic.epicE2e
      tEpicReview = instanceOf tower.epic.epicReview
    }

    wtA = worktreeBox "feature+add-recipe → feature/add-recipe" {
      description '''
**What it is:** one branch, one pair of hands. The graph keeps a feature's tasks one linked line, so the
frontier hands out one task per feature and this checkout is never written by two workers at once. Started
at `origin/feature/add-recipe`, else at `origin/epic/recipe-box` — a feature branch starts where it lands.
'''
      engA = instanceOf workers.engineer
      unitA = instanceOf workers.testerUnit
      feA = instanceOf workers.frontend
      featTestA = instanceOf workers.testerFeature
      revA = instanceOf workers.reviewAgent
      tBackendA = instanceOf tower.featA.backendA
      tUnitA = instanceOf tower.featA.unitA
      tFrontA = instanceOf tower.featA.frontendA
      tFeatA = instanceOf tower.featA.featureTestA
      tRevA = instanceOf tower.featA.featureReviewA
    }

    wtB = worktreeBox "feature+search-recipes → feature/search-recipes" {
      description '''
**What it is:** the second feature's worktree, alive at the same time as the first — two features in
parallel, each alone on its own branch.
'''
      engB = instanceOf workers.engineer
      unitB = instanceOf workers.testerUnit
      feB = instanceOf workers.frontend
      featTestB = instanceOf workers.testerFeature
      revB = instanceOf workers.reviewAgent
      tBackendB = instanceOf tower.featB.backendB
      tUnitB = instanceOf tower.featB.unitB
      tFrontB = instanceOf tower.featB.frontendB
      tFeatB = instanceOf tower.featB.featureTestB
      tRevB = instanceOf tower.featB.featureReviewB
    }
  }

  // Inside a box: the worker that runs there against the ticket whose work lands there.
  towerRoot.wtA.engA -> towerRoot.wtA.tBackendA "one commit: validateRecipe + saveRecipe"
  towerRoot.wtA.unitA -> towerRoot.wtA.tUnitA "one commit: the micro tier"
  towerRoot.wtA.feA -> towerRoot.wtA.tFrontA "one commit: the UI"
  towerRoot.wtA.featTestA -> towerRoot.wtA.tFeatA "one commit: the suite"
  towerRoot.wtA.revA -> towerRoot.wtA.tRevA "no commit: PR comments"

  towerRoot.wtB.engB -> towerRoot.wtB.tBackendB "one commit: searchRecipes"
  towerRoot.wtB.unitB -> towerRoot.wtB.tUnitB "one commit: the micro tier"
  towerRoot.wtB.feB -> towerRoot.wtB.tFrontB "one commit: the UI"
  towerRoot.wtB.featTestB -> towerRoot.wtB.tFeatB "one commit: the suite"
  towerRoot.wtB.revB -> towerRoot.wtB.tRevB "no commit: PR comments"

  towerRoot.wtEpic.mergeRun -> towerRoot.wtEpic.tMerge "assembles the feature branches"
  towerRoot.wtEpic.e2eRun -> towerRoot.wtEpic.tE2e "journeys on the real stack"
  towerRoot.wtEpic.epicReviewRun -> towerRoot.wtEpic.tEpicReview "no commit: PR comments"
}
