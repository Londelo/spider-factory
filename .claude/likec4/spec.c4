specification {
  color opBlue #2563EB
  color workerPurple #7C3AED
  color plannerTeal #0891B2
  color hookCyan #0E7490
  color gateAmber #D97706
  color errorRed #DC2626
  color infraGray #6B7280
  color ticketSlate #64748B
  color branchGreen rgb(5 150 105)

  element layer {
    style {
      color muted
      shape rectangle
    }
  }

  element dispatcher {
    style {
      color opBlue
      shape component
      icon bootstrap:terminal-fill
    }
  }

  element worker {
    style {
      color workerPurple
      shape agent
      icon bootstrap:robot
    }
  }

  element planner {
    style {
      color plannerTeal
      shape agent
      icon bootstrap:compass
    }
  }

  element hook {
    style {
      color hookCyan
      shape component
      icon bootstrap:gear-fill
    }
  }

  element gate {
    style {
      color gateAmber
      shape rectangle
      icon bootstrap:lock-fill
    }
  }

  element ticket {
    style {
      color ticketSlate
      shape document
      icon bootstrap:file-earmark-text-fill
    }
  }

  element human {
    style {
      color infraGray
      shape person
      icon bootstrap:person-fill
    }
  }

  element beadsStore {
    style {
      color infraGray
      shape storage
      icon bootstrap:journal-text
    }
  }

  element remote {
    style {
      color infraGray
      shape cylinder
      icon bootstrap:cloud-fill
    }
  }

  element noteDoc {
    style {
      color infraGray
      shape document
      icon bootstrap:clipboard-check
    }
  }

  element failure {
    style {
      color errorRed
      shape rectangle
      border dashed
      icon bootstrap:exclamation-triangle-fill
    }
  }

  relationship blocks {
    description "depends-on — the chain reads left to right, oldest first"
    color infraGray
    line dashed
  }

  relationship dispatches {
    description "the AGENT map: one edge per dispatching label"
    color opBlue
  }

  relationship works {
    description "the worker points at the ticket its label owns"
    color workerPurple
  }

  relationship plans {
    description "top-down tower build; each plan agent writes only its own tier's branch"
    color plannerTeal
    line dashed
  }

  relationship closes {
    description "only a human closes a gate"
    color gateAmber
  }

  relationship raises {
    description "where an error pops up"
    color errorRed
    line dotted
  }

  deploymentNode worktreeBox {
    notation "Branch worktree"
    style {
      color branchGreen
    }
  }

  tag error
  tag leftClaimed
  tag unclaimed
  tag stateProbe
}
