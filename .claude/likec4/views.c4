views {

  // ═════════════════════════════════════════════════════════════════════════════
  // Four walkthroughs and nothing else. Every node on a page is either pointed at
  // by a step or sits inside a box a step points at.
  //   1 · the plan     — a person turns an idea into sixteen tickets
  //   2 · the run      — the CLI on PATH, the loop started, ticket after ticket
  //   3 · the log      — what a run writes and how to read a stuck tower
  //   4 · the failures — the same run with every alarm firing
  // A step here says only what happens at that moment. What a thing *is*, and
  // every rule and table behind it, lives in that node's own description in
  // model.c4 — click the node, not the step.
  // ═════════════════════════════════════════════════════════════════════════════

  // ────────────────────────────────────────────────────────────────────────────
  // 1 · THE PLANNING PHASE
  // ────────────────────────────────────────────────────────────────────────────

  dynamic view index {
    title "Binary Obelisk/Walkthrough/1 · The planning phase — a vague idea becomes sixteen tickets"

    include human, planAgents, planAgents.*, beads, tower, tower.*

    // ═ ACT I — a person plans it, and the tower appears in the database

    human -> planAgents.planEpic "a vague idea: I want somewhere to keep my recipes" {
      title "You describe the idea; the planner asks questions and settles it"
      notes """
It agrees one name for the epic — `epic/recipe-box` — and then writes four tickets. Nothing runs yet.
"""
    }

    planAgents.planEpic -> beads "four tickets paid into the database" {
      title "The epic gate, plus the merge, the end-to-end tests, and the review"
      notes """
| Ticket | What it is for | Who does it |
|---|---|---|
| RECIPE-1 | the epic itself, and its gate — you close this one at the end | nobody |
| RECIPE-2 | joins the two finished feature branches onto the epic branch | merge |
| RECIPE-3 | tests the whole flow in a real browser | tester-e2e |
| RECIPE-4 | reviews the whole epic and posts findings on the pull request | review |
"""
    }

    human -> planAgents.planFeature "break the epic into features" {
      title "One epic in, two features out"
      notes """
A feature is one complete thing a user can do, not a layer of the app: add a recipe, search the box. Each
feature gets its own branch and its own pull request, and the two run side by side.
"""
    }

    planAgents.planFeature -> beads "six more tickets: two gates, two suites, two reviews" {
      title "Each feature gets its gate, its test suite, and its review"
      notes """
| Ticket | What it is for | Who does it |
|---|---|---|
| RECIPE-5 / RECIPE-11 | the feature's gate, and the only row that carries its branch name — you close it | nobody |
| RECIPE-9 / RECIPE-15 | proves the feature's pieces are wired together | tester-feature |
| RECIPE-10 / RECIPE-16 | reviews the feature branch and posts findings on its pull request | review |

Three blocking edges are written here, and only this agent can write them: the review waits on the suite,
the gate waits on the review, and the epic's merge ticket waits on this gate. Miss that last one and the
merge runs against half-built features and still reports green.
"""
    }

    human -> planAgents.planTask "break this one feature into tasks" {
      title "One feature in, its chain of tasks out"
      notes """
Run once per feature, and it takes one feature ticket or it refuses. It writes only the logic, that logic's
tests, and the interface — everything above was written already.
"""
    }

    planAgents.planTask -> beads "RECIPE-6 then 7 then 8, and RECIPE-12 then 13 then 14" {
      title "Six tickets, one chain per feature"
      notes """
| Ticket | What it is for | Who does it | Waits on |
|---|---|---|---|
| RECIPE-6 / RECIPE-12 | the feature's logic | engineer | nothing |
| RECIPE-7 / RECIPE-13 | that logic's tests, every case | tester-unit | the logic |
| RECIPE-8 / RECIPE-14 | the feature's interface, styling included | frontend | its tests |

Each ticket waits only on the one before it. That is why one worker at a time ever touches a feature branch,
and the last task is what unblocks that feature's test suite.
"""
    }

    human -> beads "bd list — all sixteen are in the tower" {
      title "Sixteen tickets in the database, and only two can be claimed"
      notes """
Four from the epic plan, six from the feature plan, six from the task plans. The two heads of the chains —
RECIPE-6 and RECIPE-12 — are ready; everything else is behind a blocker or an open gate. The database is all
the loop ever reads.
"""
      navigateTo theLoop
    }

    autoLayout LeftRight
  }

  // ────────────────────────────────────────────────────────────────────────────
  // 2 · INSTALLING THE CLI AND RUNNING THE LOOP
  // ────────────────────────────────────────────────────────────────────────────

  dynamic view theLoop {
    title "Binary Obelisk/Walkthrough/2 · The run — install the CLI, start the loop, one ticket at a time"

    include
      human,
      machine,
      machine.boCli,
      machine.knobs,
      machine.preflight,
      machine.dispatcher,
      machine.agentMap,
      machine.spawnEnv,
      machine.claim,
      beads,
      tower.*,
      toolbelt,
      toolbelt.bdCmds,
      toolbelt.worktree,
      toolbelt.gitCli,
      toolbelt.forgeCli,
      toolbelt.claudeCli,
      forge,
      workers,
      workers.engineer,
      workers.testerUnit,
      workers.frontend,
      workers.testerFeature,
      workers.testerE2e,
      workers.reviewAgent,
      workers.mergeAgent,
      stopHook,
      waiting,
      waiting.towerStalled

    // ═ ACT I — put the dispatcher on PATH once, then start the run

    human -> machine.boCli "install the CLI once" {
      title "One command puts `bo` on your path"
      notes """
It copies a small real file to `~/.local/bin/bo` that runs the plugin's own command. Run it again after an
update or a move. If it warns about PATH, add the export line it prints to your shell profile.
"""
    }

    human -> machine.boCli "bo loop, from inside the project" {
      title "You start the loop, and it runs until you stop it"
      notes """
One command, in this terminal, printing every tick. Ctrl-C is the only thing that ends it. It plans nothing
and merges nothing.
"""
      navigateTo everyFailure
    }

    machine.knobs -> machine.dispatcher "4 parallel · 3 s · logs under ~/.binary-obelisk · labels *" {
      title "The settings are read once, at startup"
      notes """
How many workers at once, how often it checks, where the logs go, which labels it may dispatch. A value
typed wrong stops the run rather than being quietly replaced.
"""
    }

    machine.dispatcher -> machine.preflight "before the first tick: six checks" {
      title "Six checks, and five of them stop the run"
      notes """
The tools it needs, the settings, a ticket database here, a log folder it can write. The sixth — the label
list — starts anyway and dispatches nothing, which is the one that bites.
"""
      navigateTo everyFailure
    }

    // ═ ACT II — one ticket, end to end

    machine.dispatcher -> beads "what is ready?" {
      title "The loop asks the database what is ready"
      notes """
The ticket graph is the only thing it knows about the project. It keeps no state of its own, so restart it
and it picks the same place.
"""
    }

    machine.dispatcher -> toolbelt.bdCmds "the ticket commands the loop runs" {
      title "Nine ticket commands, and only the loop runs them"
      notes """
Two of them matter here: the one that takes a ticket, and the one that writes a pull request url onto one.
"""
    }

    machine.dispatcher -> machine.claim "round 1 — take one ticket" {
      title "Count what is already running, then take one ticket"
      notes """
Four workers already running means no claim this tick. Otherwise the ticket comes back with its label, its
branch, and its parent already on it — that is enough to route it with no further reading.
"""
    }

    machine.claim -> tower.featA.backendA "RECIPE-6" {
      title "The ticket already knows its feature, its branch, and its worker"
      notes """
Label `backend-logic`, so the engineer; branch `feature/add-recipe`, from its feature RECIPE-5. Nothing else
in the tower is unblocked, which is the only reason this ticket came up.
"""
    }

    machine.dispatcher -> tower.epic "where does this land?" {
      title "The pull request's target comes from the epic gate"
      notes """
Ticket → feature → epic, and the epic's own branch is where the work lands. It is read there every time and
never copied onto tickets, so it cannot drift from the gate it came from.
"""
    }

    machine.dispatcher -> toolbelt.forgeCli "publish the epic branch and its pull request, once" {
      title "The epic's branch exists before any worker starts"
      notes """
Push `epic/recipe-box`, open its pull request, write the url on the epic gate. Everything below aims at that
branch, so if this fails nothing has anywhere to land: the ticket stays claimed and the run says why.
"""
    }

    toolbelt.forgeCli -> forge "PR 1 — epic/recipe-box into main" {
      title "Pull request 1: the epic branch into main"
      notes """
The loop publishes this one and nobody else. It also decides whether the forge is GitHub or GitLab, and
refuses to guess when the evidence is ambiguous.
"""
    }

    machine.dispatcher -> toolbelt.worktree "make the branch's folder" {
      title "The branch gets its own folder"
      notes """
Made the first time that branch is claimed, reused by every later ticket on it. A branch already checked out
somewhere is reused and never re-added.
"""
    }

    machine.dispatcher -> machine.agentMap "backend-logic means engineer" {
      title "One label picks one worker"
      notes """
Eight labels, eight workers, and nothing else can name a specialist. A ticket with no label or two labels
dispatches nobody and stays claimed.
"""
    }

    machine.dispatcher -> toolbelt.claudeCli "start the worker in that folder" {
      title "A worker session is started in the background"
      notes """
In that folder, on that branch. Its session id is read from that worker's own spawn output, so you can still
attach to it, read it, or stop it later.
"""
    }

    machine.dispatcher -> machine.spawnEnv "pass it which ticket this is" {
      title "Eight settings tell the worker and the hooks what they are working on"
      notes """
Ticket, branch, pull request target, worker, label, folders, log place, done marker. A worker started without
them stops itself, and its ticket sits in progress — the hooks cannot finish what they cannot identify.
"""
    }

    toolbelt.claudeCli -> workers.engineer "the rules arrive with the brief" {
      title "The worker's prompt is the five rules it must follow"
      notes """
Keep your ticket alive, never close your own ticket, say what is left if you run out of room, start no other
workers, stay on your branch and never commit or push — and touch the done marker only when the work is
genuinely finished.
"""
    }

    workers.engineer -> tower.featA.backendA "write the code" {
      title "The engineer writes the code and leaves the ticket open"
      notes """
Files land in the branch's folder, uncommitted; it heartbeats so its claim holds, and reports in its final
message. Closing is somebody else's job.
"""
    }

    workers.engineer -> stopHook "touch the done marker, then stop" {
      title "The worker's last act is to say it is finished"
      notes """
It creates a marker file. The loop deletes it before each start, so only this session could have made it. The
session ending alone proves nothing — that file is the statement.
"""
    }

    stopHook -> toolbelt.gitCli "commit and push, only on that marker" {
      title "The hook commits and pushes — after checking, not assuming"
      notes """
The ticket must still be in progress, the branch settings must have arrived, and the folder must be on the
branch it thinks it is. Then the ticket's title becomes the commit message. A test or review ticket may land
nothing, and that is fine.
"""
    }

    stopHook -> toolbelt.forgeCli "the pull request for this branch" {
      title "One branch, one pull request, forever"
      notes """
It looks for an open pull request on this branch first; only if there is none does it make one. The next
ticket on this branch reuses it, because the branch — not the ticket — is the unit of work.
"""
    }

    toolbelt.forgeCli -> forge "PR 2 — feature/add-recipe into epic/recipe-box" {
      title "Pull request 2: the feature branch into the epic branch"
      notes """
It aims at the epic's branch, not at main. This tower has three pull requests in all: one epic, one per
feature.
"""
    }

    stopHook -> beads "write the url, then close" {
      title "The url goes on the ticket, then the hook closes it"
      notes """
Written first, closed second — if the url cannot be written the hook stops rather than close a ticket whose
pull request is unfindable. That close is what unblocks the next ticket in the chain.
"""
      navigateTo everyFailure
    }

    // ═ ACT III — the same five steps, thirteen times, in the order the graph releases them

    machine.dispatcher -> machine.claim "the rounds — 13 tickets the loop dispatches" {
      title "One ticket at a time, in the order the graph releases them"
      notes """
Each round is the five steps above again. Within a feature the order is fixed — logic, its tests, the
interface, the suite, the review — because each ticket waits on the one before. Across features the order can
interleave, because nothing joins the two. The three gates are never dispatched: a person closes those.
"""
    }

    machine.dispatcher -> workers.engineer "RECIPE-12 — the other feature's logic" {
      title "The engineer takes the second feature"
      notes """
Claimed in the same round, its own branch, its own folder, its own pull request. Closing this releases its
tests.
"""
    }

    machine.dispatcher -> workers.testerUnit "RECIPE-7 — the tests for that logic" {
      title "The unit tester covers one function completely"
      notes """
Every branch, every boundary, every error that function can throw, in its own test file. Second commit on the
same branch, same pull request. Releases the interface ticket.
"""
    }

    machine.dispatcher -> workers.testerUnit "RECIPE-13 — the other feature's tests" {
      title "The same depth on the other feature"
      notes """
The search side's functions, its own branch and pull request. Releases that feature's interface.
"""
    }

    machine.dispatcher -> workers.frontend "RECIPE-8 — the interface" {
      title "The interface is built last, against proved functions"
      notes """
The whole component including its styling — one ticket, no separate styling task. Releases that feature's test
suite.
"""
    }

    machine.dispatcher -> workers.frontend "RECIPE-14 — the other feature's interface" {
      title "The search interface, on its own branch"
      notes """
The box, the results, the empty state, the error state. When four workers are already running a tick claims
nothing and writes a waiting line instead — that is not a failure.
"""
    }

    machine.dispatcher -> workers.testerFeature "RECIPE-9 — is it wired together?" {
      title "The feature tester proves the pieces are wired together"
      notes """
One case per path, in a real browser, on the finished feature branch — and every error and success the feature
has actually reaches the user. It does not repeat the unit tests and it does not leave the feature. Releases
the review.
"""
    }

    workers.testerFeature -> tower.featA "everything it proves is inside one feature" {
      title "Nothing is tested against half a feature"
      notes """
The three test tiers differ only in scope: one function, one feature, the whole epic. The ticket's label is
what says which, and that is why the chain had to finish before this ticket existed to claim.
"""
    }

    machine.dispatcher -> workers.testerFeature "RECIPE-15 — the other feature's wiring" {
      title "The search side's wiring"
      notes """
Type a query, results appear; a query with no matches shows an empty state, not a crash. Releases that
feature's review.
"""
    }

    machine.dispatcher -> workers.reviewAgent "RECIPE-10 — review the feature" {
      title "The reviewer answers three questions about the branch"
      notes """
Does the code do what it is supposed to, do the tests prove it, is it readable. It reads the diff, follows the
code, adds trace logs, runs the tests against that, then posts findings as comments on the pull request. It
files nothing and commits nothing. With the other review closed, the tower waits for a person.
"""
      navigateTo theLogs
    }

    workers.reviewAgent -> tower.featA "the findings go on the pull request" {
      title "What the reviewer writes is what you read before closing"
      notes """
The same agent covers a feature here and the whole epic later — the ticket's label says how wide to look. That
report is the only reason the gate is worth having.
"""
    }

    machine.dispatcher -> workers.reviewAgent "RECIPE-16 — review the other feature" {
      title "The same review on the other feature"
      notes """
Findings on pull request 3. Both reviews ran at the same time, which is the four-worker ceiling in practice.
"""
    }

    // ═ ACT IV — the tower stops, and only a person can start it again

    machine.dispatcher -> waiting.towerStalled "nothing left to claim" {
      title "The loop is finished and does not know it"
      notes """
Both features are closed, the two feature gates are still open, and those gates hold everything above them. So
the claim came back empty, the loop checked, found work that exists but is blocked, and wrote a waiting line
instead. It writes that line once a minute and waits for you.
"""
      navigateTo everyFailure
    }

    human -> tower.featA "read PR 2, close RECIPE-5" {
      title "You read pull request 2 and close the first gate"
      notes """
Closing the gate is how the feature branch gets merged into the epic branch. No worker can do this, so the
tower is meant to stop here.
"""
    }

    human -> tower.featB "read PR 3, close RECIPE-11" {
      title "You close the second gate"
      notes """
Now nothing blocks the merge ticket, and it becomes the frontier.
"""
    }

    machine.dispatcher -> workers.mergeAgent "RECIPE-2 — join the branches" {
      title "The merge worker joins the two feature branches"
      notes """
It reads both branch names off the feature gates, merges them onto `epic/recipe-box` one at a time in its own
folder, fixes what collides, then runs the tests and reads the count rather than trusting the exit code. It
writes no code and opens no pull request of its own. Releases the end-to-end tests.
"""
    }

    workers.mergeAgent -> tower.epic "both features, on the epic branch" {
      title "The epic branch now holds both features together"
      notes """
The epic's tests and review are only honest against the assembled result — so assembly is a ticket, dispatched
and landed exactly like any other.
"""
    }

    machine.dispatcher -> workers.testerE2e "RECIPE-3 — the whole flow" {
      title "The end-to-end tester walks the whole flow"
      notes """
A recipe saved by one feature is found by the other, in a real browser, on the assembled branch. One journey
per outcome, and nothing repeated from the lower tiers.
"""
    }

    machine.dispatcher -> workers.reviewAgent "RECIPE-4 — review the epic" {
      title "The reviewer looks at the whole epic"
      notes """
The same three questions across both features, with findings on the epic's pull request. Nothing dispatches
after this.
"""
    }

    human -> tower.epic "close RECIPE-1" {
      title "You close the epic gate, and the tower is finished"
      notes """
| Who | What they did |
|---|---|
| the loop | published the epic branch and its pull request, made 3 folders (one per branch), started 13 workers, closed 13 tickets |
| you | planned all 16 tickets, read the 3 pull requests, closed the 3 gates |
"""
      navigateTo theLogs
    }

    autoLayout LeftRight
  }

  // ────────────────────────────────────────────────────────────────────────────
  // 3 · THE RUN LOG
  // ────────────────────────────────────────────────────────────────────────────

  dynamic view theLogs {
    title "Binary Obelisk/Walkthrough/3 · The run log — who writes what, and how to read a tower that is not moving"

    include human, machine.dispatcher, beads, workers.engineer, stopHook, failHook, logRun, logRun.*

    // ═ ACT I — one directory per run, and one line format that never varies

    machine.dispatcher -> logRun "one directory per run, made before the first tick" {
      title "One folder per run, with every file made up front"
      notes """
The files are created empty before anything happens, so a missing file and an empty file look alike and
neither can hide a silent failure. The folder is named for when the run started, and every line of every file
has one shape, built by one function that the loop and both hooks share.
"""
      navigateTo theLoop
    }

    // ═ ACT II — the writers, one file each

    machine.dispatcher -> logRun.fClaims "CLAIMS" {
      title "Every ticket taken, and every one put back"
      notes """
A dispatched line is the run's heartbeat. A put-back means another worker already holds that branch. Neither is
a failure. A ticket you expected that never appears here was never unblocked — go look at its blockers.
"""
    }

    machine.dispatcher -> logRun.fWaiting "WAITING" {
      title "The quiet ticks: alive, with nothing to do"
      notes """
Written only when a tick claimed nothing, and at most once a minute per reason. Two of the five reasons need a
person — nothing left to do, or work exists and something is holding it. The rest just mean full.
"""
      navigateTo everyFailure
    }

    machine.dispatcher -> logRun.fErrors "ERRORS" {
      title "Every alarm the loop saw, never capped"
      notes """
One line per alarm, naming what failed. If the tower is stuck and this file is empty, nothing is failing — read
the waiting lines instead.
"""
      navigateTo everyFailure
    }

    machine.dispatcher -> logRun.fBdStderr "bd-stderr" {
      title "The ticket tool's own complaint, kept separate"
      notes """
Whatever the claim command printed on its way out. When a claim fails, the alarm quotes this file's last line.
"""
    }

    machine.dispatcher -> logRun.fClaudeStderr "claude-stderr" {
      title "What the session counter said when it failed"
      notes """
The counter is how the loop knows it is full. It fails quietly, so without this file a broken counter looks
exactly like a full machine — forever.
"""
    }

    machine.dispatcher -> logRun.fSpawn "spawn-<ticket>" {
      title "One file per worker, holding its session id"
      notes """
The loop reads that id back out to name the worker on the log line and to close the ticket as the right actor.
One file per ticket instead of one shared file, so it is still findable hours later.
"""
    }

    workers.engineer -> logRun.fDone "done-<ticket>" {
      title "The worker's own word that it finished"
      notes """
Made by the worker as its very last action, and deleted by the loop before the worker starts. The hook commits
nothing without it.
"""
    }

    machine.dispatcher -> logRun "one tick, the four files it touches" {
      title "One ticket's whole life is four files"
      notes """
The spawn file appears when the worker starts, the done file when it declares itself finished, then a claims
line and a closes line. Search the ticket id across the folder and the whole life reads in one screen.
"""
    }

    stopHook -> logRun.fCloses "CLOSES" {
      title "Proof of work, written last"
      notes """
One line per ticket that really landed, with its pull request url, written after the commit, the push, the pull
request, and the close. So a line here is a receipt, not an intention.
"""
    }

    failHook -> logRun.fFailures "FAILURES" {
      title "What a session that died mid-turn left behind"
      notes """
Which state the ticket was in, what kind of failure the session reported, and the worker's last message. This is
the only place any of that is recorded.
"""
    }

    machine.dispatcher -> logRun.fResults "RESULTS" {
      title "The tally, written once at the end"
      notes """
Written when the run hits its tick limit or you press Ctrl-C, and the line says which of those ended it. How
many tickets it claimed is the number that says whether the run did anything at all.
"""
    }

    // ═ ACT III — reading a tower that is not moving

    human -> logRun "the four files, in this order" {
      title "How to read a tower that is not moving"
      notes """
| Ask | Read |
|---|---|
| Is the loop alive? | the newest folder; `results` only exists if the run ended |
| Is it failing? | `errors` — empty means nothing is failing |
| Why nothing claimed? | `waiting` — the reason, and how many workers are live |
| Did this ticket ship? | `claims`, then `closes`, then its `spawn-<ticket>` |
| Why did this worker die? | `failures`, then `done-<ticket>` — no marker means it never said it was done |
"""
      navigateTo everyFailure
    }

    beads -> logRun "and the log is not the state" {
      title "The database is the truth; the log is the testimony"
      notes """
Nothing decides anything from a log line — delete the folder and no tick changes. So a log can be rotated or
thrown away safely; what it can never be is contradictory, because it is written from the same facts the tick
acted on.
"""
      navigateTo index
    }

    autoLayout LeftRight
  }

  // ────────────────────────────────────────────────────────────────────────────
  // 4 · EVERY FAILURE
  // ────────────────────────────────────────────────────────────────────────────

  dynamic view everyFailure {
    title "Binary Obelisk/Walkthrough/4 · Every failure — the same tower with every alarm firing"

    include
      human,
      machine.dispatcher,
      beads,
      toolbelt.claudeCli,
      stopHook,
      failHook,
      logRun.fErrors,
      alarms,
      alarms.startupAlarms,
      alarms.startupAlarms.*,
      alarms.tickAlarms,
      alarms.tickAlarms.*,
      alarms.stopAlarms,
      alarms.stopAlarms.*,
      alarms.failAlarms,
      alarms.failAlarms.*,
      waiting,
      waiting.*

    // ═ PART A — the run never starts

    machine.dispatcher -> alarms.startupAlarms.toolsMissing "bd jq claude git — <tool> not found · exit 1" {
      title "A tool is missing, and the run will not start"
      notes """
It checks the tools before doing anything, and quits rather than start half-ready. The Stop hook checks a
shorter list of its own, because it never starts a session.
"""
    }

    machine.dispatcher -> alarms.startupAlarms.knobNotNumeric "BO_MAX_PARALLEL=four is not a number · exit 1" {
      title "A setting is not a number, and the run will not start"
      notes """
These settings decide how many unattended sessions run, so none of them is quietly replaced with a default.
"""
    }

    machine.dispatcher -> alarms.startupAlarms.pollUnusable "BO_POLL_S=7 is unusable · exit 1" {
      title "The poll interval cannot work, and the run will not start"
      notes """
Only 1 2 3 4 5 6 10 12 15 20 30 60 are usable: the waiting lines are one a minute, and that promise only holds
if the interval divides the minute.
"""
    }

    machine.dispatcher -> alarms.startupAlarms.noBeadsDb "no ticket database found from here · exit 1" {
      title "No ticket database here, and the run will not start"
      notes """
It asks the ticket tool whether a database answers from this directory, rather than looking for a folder — the
tool searches upward, so a database nearby is not the same as one here.
"""
    }

    machine.dispatcher -> alarms.startupAlarms.logDirUnwritable "cannot write the log folder · exit 1" {
      title "The log folder cannot be written, and the run will not start"
      notes """
Fatal on purpose: a run that cannot write its logs cannot raise an alarm, and a silent dispatcher is the one
thing this design refuses to be.
"""
    }

    machine.dispatcher -> alarms.startupAlarms.labelsStarved "BO_ALLOWED_LABELS=<typo> — the run starts and does nothing" {
      title "The one startup mistake that does NOT stop the run"
      notes """
Then no ticket ever matches a label, nothing is ever dispatched, and the waiting lines keep arriving on
schedule. Check the tickets' labels against the eight the loop knows.
"""
    }

    // ═ PART B — the tick fails, and the ticket's fate is the interesting part

    machine.dispatcher -> alarms.tickAlarms.bdFailure "ERROR reason=bd-failure exit=2" {
      title "The claim command itself failed"
      notes """
Either it exited badly — its last line is quoted in the alarm — or it came back with nothing usable in it. The
next tick tries again. An empty answer is not this one: that is a waiting line.
"""
    }

    machine.dispatcher -> beads "empty claim — check whether blocked work exists" {
      title "An empty claim is two opposite situations"
      notes """
Nothing left to do, or work that exists and is blocked. The loop probes the database to write the right line,
because those two must never look alike.
"""
      navigateTo index
    }

    machine.dispatcher -> alarms.tickAlarms.labelAmbiguous "ERROR reason=label-ambiguous · LEFT CLAIMED" {
      title "The label names no worker, or two"
      notes """
The ticket is left claimed so its five-minute lease parks it off the queue, instead of the loop spinning on an
unworkable ticket every tick. Usual cause: a ticket labelled with the wrong word, which looks identical to
having none.
"""
      navigateTo index
    }

    machine.dispatcher -> alarms.tickAlarms.metadataMissing "ERROR reason=metadata-missing · LEFT CLAIMED" {
      title "The ticket has no branch on it"
      notes """
Its plan step skipped that one key. The loop never invents a branch — a planning mistake stays a planning
mistake, where you can see it.
"""
    }

    machine.dispatcher -> beads "reason=branch-busy — put the claim back and try the next" {
      title "The branch it just claimed was already working"
      notes """
The claim goes straight back and the next ticket is tried, up to six attempts a tick. On a properly chained
tower this never happens — the chain already keeps two workers off one branch, so this alarm is how you find a
tower that was never chained.
"""
    }

    machine.dispatcher -> alarms.tickAlarms.epicPrFailed "ERROR reason=epic-pr-failed step=push · LEFT CLAIMED" {
      title "The epic's branch or pull request could not be published"
      notes """
The `step=` names where it died: walking up to the gate, the gate's own branch, the forge, its command line
tool, the push, the pull request, or writing the url back on the gate. Left claimed every time — a worker under
a branch that does not exist burns a slot and files a commit nobody can pull.
"""
    }

    machine.dispatcher -> alarms.tickAlarms.worktreeFailed "ERROR reason=worktree-failed · LEFT CLAIMED" {
      title "The branch's folder could not be made"
      notes """
Nothing it could start the branch from existed, or the folder was already in use by another branch. Same
treatment as a mislabelled ticket: a worker started into a missing folder wastes a slot on nothing.
"""
    }

    machine.dispatcher -> alarms.tickAlarms.workerNotDispatched "ERROR reason=worker-not-dispatched · put it back" {
      title "The worker never started, so the ticket goes straight back"
      notes """
The start command failed and the reason is in that worker's own spawn file — this is also what an agent name
with no file behind it looks like. Nothing was ever started to work this ticket, so unlike every other tick
failure it is returned at once, and the next tick may well succeed.
"""
    }

    // ═ PART C — the Stop hook refuses fifteen times, in code order

    stopHook -> alarms.stopAlarms.missingToolHook "ERROR reason=missing-tool tool=git" {
      title "1 of 15 · the ticket stays claimed"
      notes """
Checked before anything else the hook does, but after the check that this is a dispatched worker at all — a
session the loop never started exits quietly instead of alarming about somebody else's project.
"""
    }

    stopHook -> alarms.stopAlarms.noWorktreeHook "ERROR reason=no-worktree" {
      title "2 of 15"
      notes """
The hook was not told which folder the work is in, and it will not guess from its own location — guessing here
means committing whatever happens to be lying around.
"""
    }

    stopHook -> alarms.stopAlarms.ticketNotInWork "ERROR reason=ticket-not-in-work state=open" {
      title "3 of 15 · and silent when the ticket is already closed"
      notes """
The ticket is not in progress. If it is closed this is a second stop in a session that already shipped, and the
hook leaves quietly — committing onto a shared branch twice is exactly what it is there to prevent.
"""
    }

    stopHook -> alarms.stopAlarms.noBranchHook "ERROR reason=no-branch" {
      title "4 of 15"
      notes """
The branch never reached the session, so the loop never got as far as reading it off the claim.
"""
    }

    stopHook -> alarms.stopAlarms.noPrTarget "ERROR reason=no-pr-target" {
      title "5 of 15"
      notes """
The pull request's target never reached the session. The hook will not open a pull request into a guess.
"""
    }

    stopHook -> alarms.stopAlarms.notDeclaredDone "ERROR reason=not-declared-done" {
      title "6 of 15 · the gate of the whole design"
      notes """
The done marker is not there: the session ended without saying, in the one place both programs read, that its
work is finished. No commit, no push, no pull request, no close. The ticket stays claimed, which parks it off
the queue, and everything chained behind it waits.
"""
    }

    stopHook -> alarms.stopAlarms.wrongBranch "ERROR reason=wrong-branch want=feature/add-recipe" {
      title "7 of 15"
      notes """
The folder is not on the branch it should be — the worker was told never to change branches, and this is the
last place that can refuse to file the work under the wrong ticket's name.
"""
    }

    stopHook -> alarms.stopAlarms.noTitle "ERROR reason=ticket-has-no-title" {
      title "8 of 15"
      notes """
The commit message is the ticket's title, so a ticket with no title cannot be filed — it would be an anonymous
commit on a shared branch.
"""
    }

    stopHook -> alarms.stopAlarms.commitFailed "ERROR reason=commit-failed" {
      title "9 of 15 · and an empty tree is NOT this"
      notes """
The commit itself failed. A review or test ticket landing nothing is normal and is skipped quietly, so this line
means a genuine failure.
"""
    }

    stopHook -> alarms.stopAlarms.pushFailed "ERROR reason=push-failed" {
      title "10 of 15"
      notes """
The push failed and its output is quoted in the alarm. The commit stays where it is and the ticket stays
claimed — nothing is rolled back, because a local commit is evidence, not a mistake to hide.
"""
    }

    stopHook -> alarms.stopAlarms.forgeUnknown "ERROR reason=forge-unknown remote=<url>" {
      title "11 of 15 · reached only after the commit and the push"
      notes """
It could not tell whether this is GitHub or GitLab, and it refuses to guess: a wrong guess pushes a branch to
the wrong forge.
"""
    }

    stopHook -> alarms.stopAlarms.forgeToolMissing "ERROR reason=missing-tool tool=gh forge=github" {
      title "12 of 15 · same reason as alarm 1, different tool"
      notes """
It knows the forge now, but that forge's command line tool is not installed. The forge name on the line is how
you tell this from the up-front check.
"""
    }

    stopHook -> alarms.stopAlarms.prNotCreated "ERROR reason=pr-not-created forge=github" {
      title "13 of 15"
      notes """
Looking for an existing pull request and making a new one both failed, or the tool printed an error quoting some
other address — only something that reads like a pull request number counts as one.
"""
    }

    stopHook -> alarms.stopAlarms.ticketNotAnnotated "ERROR reason=ticket-not-annotated pr=<url>" {
      title "14 of 15 · the work is out there, the ticket cannot say where"
      notes """
Writing the pull request url onto the ticket failed, so the hook stops rather than close a ticket whose pull
request nobody could find again.
"""
    }

    stopHook -> alarms.stopAlarms.closeFailed "ERROR reason=close-failed pr=<url>" {
      title "15 of 15 · everything else already succeeded"
      notes """
The commit, the push and the pull request are all out there with no record in the tower. The ticket tool will
not close a ticket unless the closer is who it says it is — the loop claimed this one, so the hook passes the
worker's real session id; when that id is stale, this is where it surfaces.
"""
    }

    // ═ PART D — the session dies instead of finishing

    toolbelt.claudeCli -> failHook "StopFailure — the reason arrives on input" {
      title "A worker session dies instead of finishing"
      notes """
The harness itself fires this hook and hands over what failed and the worker's last message — which for a local
model is where the real error text is. The reason goes on the ticket *before* its status changes.
"""
    }

    failHook -> alarms.failAlarms.ticketNotFoundFail "ERROR reason=ticket-not-found" {
      title "The ticket is gone, or is no longer this worker's"
      notes """
No state came back at all. Anything not in progress is left alone — a dead session must not rewrite a ticket
another worker owns.
"""
    }

    failHook -> alarms.failAlarms.failNotAnnotated "ERROR reason=ticket-not-annotated kind=unknown" {
      title "The reason would not write, so the status is not touched"
      notes """
A ticket parked as failed with nothing said about why is worse than one left as it was.
"""
    }

    failHook -> alarms.failAlarms.statusNotSet "ERROR reason=status-not-set from=in_progress" {
      title "Looks like a live worker, and is a dead one"
      notes """
The reason is on the ticket but the status never changed, so it still reads as in progress and stays off the
queue. Nothing here brings it back — the missing line in `failures` beside a parked ticket is how you catch it.
"""
    }

    // ═ PART E — not failures: the ticks that had nothing to dispatch

    machine.dispatcher -> waiting.maxParallel "WAITING … reason=max_parallel in_progress=4" {
      title "Four workers running, so this tick claims nothing"
      notes """
The count is taken fresh from the live sessions every tick — never from a counter the loop keeps — so a session
that died quietly cannot hold a slot forever.
"""
    }

    machine.dispatcher -> waiting.maxParallelStalled "WAITING … reason=max_parallel_stalled in_progress=0" {
      title "Full, with nothing in progress: the slots are ghosts"
      notes """
Sessions counted busy, no ticket being worked. The two counts disagreeing is the whole alarm.
"""
    }

    machine.dispatcher -> waiting.branchBusyWaiting "WAITING … reason=branch_busy held=3" {
      title "Every claim this tick wanted a busy branch"
      notes """
Three claims taken and put back inside the six-attempt limit. On a chained tower this line never appears — its
appearance says the tower was built as a fan.
"""
    }

    machine.dispatcher -> waiting.frontierEmpty "WAITING … reason=frontier_empty" {
      title "The calm one: finished, or never planned"
      notes """
Nothing to claim, and the probe found no blocked work either.
"""
      navigateTo index
    }

    machine.dispatcher -> waiting.towerStalled "WAITING … reason=tower_stalled waiting=2" {
      title "Work exists and something is holding it — usually an open gate"
      notes """
The number counts work tickets only, so the gate two levels above is invisible in it and is nearly always the
cause. Only a person closes a gate, so the loop writes this line once a minute and waits.
"""
      navigateTo index
    }

    // ═ PART F — where all of it lands

    machine.dispatcher -> logRun.fErrors "ERROR … never rate-limited" {
      title "Every alarm lands in one file, whoever saw it"
      notes """
The loop and both hooks write it, and unlike the waiting lines it is never capped. When the tower is stuck: the
waiting lines for the reason, this file for the refusal, then whether any session is even alive.
"""
      navigateTo theLogs
    }

    human -> beads "and every one of these is a person's call" {
      title "None of these fix themselves"
      notes """
Nothing here ever puts a claim back, un-parks a ticket, or closes a gate. The refusals are the price of letting
unattended workers commit onto shared branches, and what they buy is a tower that stops and says why.
"""
      navigateTo index
    }

    autoLayout LeftRight
  }
}
