views {

  // ═════════════════════════════════════════════════════════════════════════════
  // THE FRONT DOOR — the whole system in one thread: a person types one command
  // and a ticket ends up closed by a hook that refused to trust them.
  // ═════════════════════════════════════════════════════════════════════════════

  dynamic view index {
    title "Binary Obelisk/Walkthrough/Index — one command, one claim, one closed ticket"

    include human, boCli, dispatcher, beads, agentMap, claudeCli, gitCli, forgeCli, forge,
      spawnEnv, lineDef, logRun, stopHook, workers.engineer

    human -> boCli "bo loop, from inside the tower" {
      notes '''
`bo` has exactly one subcommand. Before the engine starts it probes the directory:
`bd list --limit 1 --json` must answer an **array** — `bd` walks *up* from the cwd, so a
`BEADS_DIR` in the environment does not save a wrong directory. Then it prints
`bo: dispatching $PWD — Ctrl-C to stop.` and `bash`es `../beads-loop.sh` **in the foreground**,
so every tick is on the terminal.
'''
    }

    dispatcher -> beads "bd ready --claim --json" {
      notes '''
The only sanctioned claim — atomic: assignee set, status `in_progress`, a 5-minute lease.
A bare `bd ready` is not atomic and would let two loops take the same ticket.

```json
[{ "id": "RECIPE-6", "title": "validateRecipe + saveRecipe — pure functions",
   "status": "in_progress", "assignee": "brodie", "issue_type": "task",
   "labels": ["backend-logic"], "parent": "RECIPE-5",
   "metadata": { "branch": "feature/add-recipe" } }]
```

Two facts come out of this one payload and nothing else reads the ticket's text:
the **label** that picks the specialist and the **branch** the work lands on.
'''
      navigateTo wtTick
    }

    dispatcher -> agentMap "exactly one label may match" {
      notes '''
`backend-logic` is the only member of `.[0].labels` that is a key of the `AGENT` map and in the
allowed set, so the answer is `engineer`. Zero or two matches is the tower's bug:
`ERROR reason=label-ambiguous`, left claimed. The loop never guesses a specialist.
'''
    }

    dispatcher -> gitCli "git worktree add -B feature/add-recipe …/feature+add-recipe <start>" {
      notes '''
A worktree belongs to a **branch**, not a ticket, so the loop owns the folders.
`<start>` is the first of `origin/feature/add-recipe`, `origin/epic/recipe-box`,
`epic/recipe-box`, `HEAD` that resolves — a feature branch starts where it is going to land.
'''
    }

    dispatcher -> claudeCli "claude --bg --agent engineer --permission-mode bypassPermissions" {
      notes '''
Run with `cd` **inside** the worktree, and deliberately no `-w`: `claude --worktree` only ever
*creates* one and this branch already owns its own. Eight `BO_*` variables ride the spawn line —
that environment is the entire contract between the loop and the hooks.
'''
      navigateTo wtWorker
    }

    dispatcher -> logRun.fSpawn "the spawn output, and the session id inside it" {
      notes '''
`sessionFromSpawn` reads `backgrounded · 287d3c4c` out of *this worker's own* file — the id a human
needs to `claude attach`, read, or stop. It used to be one shared `last-spawn` that every spawn
overwrote, so the id survived only for the run's last worker.
'''
    }

    workers.engineer -> beads "bd heartbeat RECIPE-6" {
      notes '''
The worker's own first duty: keep the lease alive. Its second is to never close its own ticket —
it reports in its final message instead.
'''
    }

    workers.engineer -> logRun.fDone "touch $BO_DONE_FILE — the very last action" {
      notes '''
The worker's declaration that its brief is genuinely complete. The loop `rm -f`s the file before
spawning, so a marker can only have been made by this session. Nothing else in the system believes
a session is finished.
'''
    }

    workers.engineer -> stopHook "Stop fires when the session ends" {
      notes '''
No marker means no commit, no push, no PR, no close — `ERROR reason=not-declared-done`, and the
ticket stays claimed so its lease parks it off the frontier and every task behind it waits.
'''
      navigateTo wtStop
    }

    stopHook -> gitCli "git add -A; git commit -F -; git push -u origin feature/add-recipe" {
      notes '''
The commit message **is** the ticket title, plus a `Ticket: RECIPE-6` trailer. A test or review
ticket may land nothing, and `git diff --cached --quiet` skips the commit for that.
'''
    }

    stopHook -> forgeCli "the PR already on this branch, else create one" {
      notes '''
One branch, one pull request, forever: `gh pr list --head feature/add-recipe --base epic/recipe-box
--state open`, and only if that is empty, `gh pr create`. The branch, not the ticket, is the identity
of the work — which is why a task is a commit and not a branch.
'''
    }

    stopHook -> beads "bd update RECIPE-6 --set-metadata pr=… ; bd close RECIPE-6 --session 287d3c4c" {
      notes '''
`--set-metadata` **merges**, so writing `pr` never disturbs the plan's `branch`. And `bd close` is
given the real `session_id` rather than an actor override, because `bd` refuses to close a ticket whose
assignee is not the actor — and the dispatcher is the assignee.
'''
    }

    stopHook -> logRun.fCloses "url=https://github.com/…/pull/2" {
      notes '''
One line, the run's proof of work, carrying all nine identity keys — the same keys that lead back to the
`CLAIMS` line that spawned this session and forward to any `ERRORS` line it raised.
'''
    }

    human -> beads "read the report, verify the branch" {
      notes '''
The report is the worker's final message, not a ticket close. Workers never close anything.
'''
    }

    human -> tower.featA "close the gate — its PR merges into epic/recipe-box" {
      notes '''
A gate is a checkpoint, not work: `bd ready` never shows one, it does not block its own children, and
only a human closes it. What holds the next tier off the frontier is an explicit `blocked-by` edge onto
the gate itself — so the tower stalls here until someone verifies.
'''
      navigateTo wtEpic
    }

    autoLayout LeftRight
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // MAPS — what exists
  // ═════════════════════════════════════════════════════════════════════════════

  view mapsLandscape {
    title "Binary Obelisk/Maps/Landscape — the machine, the workers, the planners"

    include boCli, knobs, dispatcher, lineDef, logRun, stopHook, failHook, beads, forge,
      claudeCli, gitCli, forgeCli, human
    include workers.engineer, workers.testerUnit, workers.frontend, workers.testerFeature,
      workers.testerE2e, workers.reviewAgent, workers.mergeAgent
    include planAgents.planEpic, planAgents.planFeature, planAgents.planTask

    autoLayout LeftRight
  }

  view mapsFrontDoor {
    title "Binary Obelisk/Maps/Front door — bo, the knobs, the fatal checks"

    include human, boCli, knobs, dispatcher, beads, claudeCli, gitCli, forgeCli
    include alarms.tickAlarms.startupAbort

    autoLayout LeftRight
  }

  view mapsAgentMap {
    title "Binary Obelisk/Maps/The AGENT map — eight labels, seven workers, three tiers"

    include dispatcher, agentMap, tiersNote, beads
    include workers.engineer, workers.testerUnit, workers.frontend, workers.testerFeature,
      workers.testerE2e, workers.reviewAgent, workers.mergeAgent
    include tower.featA.backendA, tower.featA.unitA, tower.featA.frontendA, tower.featA.featureTestA,
      tower.featA.featureReviewA, tower.epic.epicE2e, tower.epic.epicReview, tower.epic.epicMergePr

    autoLayout LeftRight
  }

  view mapsTower {
    title "Binary Obelisk/Maps/The tower — gates and tickets, one linked line per feature"

    include human, beads
    include tower.epic, tower.epic.*, tower.featA, tower.featA.*, tower.featB, tower.featB.*

    autoLayout LeftRight
  }

  view mapsBranches {
    title "Binary Obelisk/Maps/Branches — two metadata keys, one PR base on the gate"

    include tower.epic, tower.featA, tower.featB, branchRules, dispatcher, stopHook, forge, forgeCli

    autoLayout LeftRight
  }

  deployment view mapsWorktrees {
    title "Binary Obelisk/Maps/Worktrees — one folder per branch, never per ticket"
    autoLayout LeftRight

    include towerRoot, towerRoot.wtEpic, towerRoot.wtA, towerRoot.wtB
    include towerRoot.wtEpic.mergeRun, towerRoot.wtEpic.e2eRun, towerRoot.wtEpic.epicReviewRun
    include towerRoot.wtEpic.tMerge, towerRoot.wtEpic.tE2e, towerRoot.wtEpic.tEpicReview
    include towerRoot.wtA.engA, towerRoot.wtA.unitA, towerRoot.wtA.feA, towerRoot.wtA.featTestA,
      towerRoot.wtA.revA
    include towerRoot.wtA.tBackendA, towerRoot.wtA.tUnitA, towerRoot.wtA.tFrontA,
      towerRoot.wtA.tFeatA, towerRoot.wtA.tRevA
    include towerRoot.wtB.engB, towerRoot.wtB.unitB, towerRoot.wtB.feB, towerRoot.wtB.featTestB,
      towerRoot.wtB.revB
    include towerRoot.wtB.tBackendB, towerRoot.wtB.tUnitB, towerRoot.wtB.tFrontB,
      towerRoot.wtB.tFeatB, towerRoot.wtB.tRevB
  }

  view mapsLog {
    title "Binary Obelisk/Maps/The log — one dir per run, eight files, nine keys"

    include dispatcher, stopHook, failHook, lineDef, spawnEnv, logRun, logRun.*

    autoLayout LeftRight
  }

  view mapsNotes {
    title "Binary Obelisk/Maps/Judgment — what the machine is never allowed to decide"

    include human, beads, decisions, tiersNote, branchRules, tower.epic, tower.featA, tower.featB

    autoLayout LeftRight
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // WALKTHROUGHS — 1: the tower gets built, top-down
  // ═════════════════════════════════════════════════════════════════════════════

  dynamic view wtPlan {
    title "Binary Obelisk/Walkthrough/1 · Plan the tower — top-down, one key each"

    include human, planAgents.planEpic, planAgents.planFeature, planAgents.planTask,
      tower.epic, tower.featA, tower.featB, tower.featA.backendA, beads

    human -> planAgents.planEpic "a recipe box — save recipes and search them" {
      notes '''
Clarifying questions, then real research, then **exactly one** epic. A colliding sibling gets
*different words*, never `-2`; the name is 2–4 lowercase words saying what the thing **is**.
'''
    }

    planAgents.planEpic -> tower.epic "bd create -t gate --parent … · branch: epic/recipe-box" {
      notes '''
One metadata key, written onto the gate **and** its three tickets as their only key:

| ticket | label | → agent |
|---|---|---|
| RECIPE-2 | `epic-merge-pr` | `merge` |
| RECIPE-3 | `epic-e2e-test` | `tester-e2e` |
| RECIPE-4 | `epic-review` | `review` |

The gate type must be registered — `bd config set types.custom "gate"` — because `bd` does not reject
an unregistered type, it **accepts and hides it**, so a broken gate and a working one look identical.
'''
    }

    human -> planAgents.planFeature "RECIPE-1" {
      notes '''
Runs off the epic id; with no epic id it asks which epic, and "there is no epic" is a valid answer —
an orphaned feature has no gate above it, so its PR aims at `main`.
'''
    }

    planAgents.planFeature -> tower.featA "bd create -t gate · branch: feature/add-recipe" {
      notes '''
Feature-sized = a **complete user-facing flow**, phased foundations → core → dependent → polish.
Two gates here: RECIPE-5 `feature/add-recipe` and RECIPE-11 `feature/search-recipes`, each with its
own `feature-test` and `feature-review`. Extra `blocks` edges order features against features.
'''
    }

    human -> planAgents.planTask "RECIPE-5" {
      notes '''
Requires a feature ticket and refuses without one. One feature at a time.
'''
    }

    planAgents.planTask -> tower.featA.backendA "bd create -l backend-logic --parent RECIPE-5" {
      notes '''
Each task: `parent-child` to the feature, **labelled at creation**, the feature's `branch` copied
**verbatim** (a plan agent never invents a branch below its own tier), chained onto its predecessor,
and every ticket verified with a `bd show --json` round trip.

The line this builds, in this order:

```
RECIPE-6 backend-logic → RECIPE-7 unit-tests → RECIPE-8 frontend-ui
         → RECIPE-9 feature-test → RECIPE-10 feature-review → RECIPE-5 (the gate)
```

The order is the logic, then its tests, then the UI — the micro tier waits on the back-end ticket it
tests and is claimed before anything is built on that function, and the suite waits on the **last**
task, because nothing is proved against half a feature.
'''
    }

    planAgents.planTask -> beads "bd show --json RECIPE-6 — the round trip" {
      notes '''
A ticket is not planned until it reads back with its label, its parent and its `branch`. Three tasks
inventing three branch names is three branches and one feature undone.
'''
    }

    autoLayout LeftRight
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // WALKTHROUGHS — 2: the run starts, and refuses to if it cannot work here
  // ═════════════════════════════════════════════════════════════════════════════

  dynamic view wtStartup {
    title "Binary Obelisk/Walkthrough/2 · Start the run — five fatal checks, then a log dir"

    include human, boCli, knobs, dispatcher, beads, claudeCli, gitCli, forgeCli, logRun,
      alarms.tickAlarms.startupAbort

    human -> boCli "BO_MAX_PARALLEL=4 BO_POLL_S=3 bo loop" {
      notes '''
| Knob | Default | What it does |
|---|---|---|
| `BO_MAX_PARALLEL` | `4` | workers alive at once; recounted from `claude agents --json` every tick |
| `BO_POLL_S` | `3` | seconds between ticks; **must divide 60** |
| `BO_MAX_TICKS` | `0` | stop after N ticks — a test seam; 0 = endless |
| `BO_LOG_ROOT` | `~/.binary-obelisk/logs` | parent of this run's one timestamped dir |
| `BO_ALLOWED_LABELS` | unset or `*` | a comma list narrows which labels may dispatch |
'''
    }

    boCli -> beads "bd list --limit 1 --json | jq -e 'type == \"array\"'" {
      notes '''
`bo`'s own gate, before it even starts the engine. `bd` walks **up** from the cwd and ignores
`BEADS_DIR`, so this is a real probe of "can anything be done here", not a look for a `.beads` folder.
Failure: `no beads database found from $PWD — cd into the tower project and re-run`, `exit 1`.
'''
    }

    boCli -> dispatcher "bash $here/../beads-loop.sh, in the foreground"

    dispatcher -> knobs "read once, at startup" {
      notes '''
Each check is fatal (`exit 1`) and each message names the value it rejected:

```
beads-loop: jq not found on PATH                       (bd jq claude git)
BO_MAX_PARALLEL=abc is not a number
BO_POLL_S=7 is unusable — it must divide 60 (1 2 3 4 5 6 10 12 15 20 30 60)
no beads database found from $PWD — cd into the tower project and re-run
cannot create /home/dev/.binary-obelisk/logs/2026-11-04_09-12-01
```

The poll interval has to divide 60 because the idle rate limit is expressed in ticks per minute
(`60 / BO_POLL_S`) — a non-divisor would make "one a minute per reason" mean nothing.
'''
    }

    dispatcher -> logRun "mkdir -p the one dir this run writes" {
      notes '''
`BO_LOG_ROOT/<date>_<time>`, and the engine creates **every** file up front — `claims errors waiting
results closes failures` — so a missing file and an empty file look the same and neither hides a silent
failure. `closes` and `failures` are written by the hooks, possibly long after the run ended.
'''
    }

    dispatcher -> dispatcher "tick; sleep $BO_POLL_S; tick; …" {
      title "the run, once it is running"
      notes '''
`while true; do tick; done`, with `tickCount` and `claimCount` kept for the `results` line, and
`onInterrupt` printing the tally on Ctrl-C. Workers run `bypassPermissions` unattended, so this loop
only ever belongs in a repo you fully trust.
'''
      navigateTo wtTick
    }

    autoLayout LeftRight
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // WALKTHROUGHS — 3: ONE TICK, every parameter named, in the order the code runs it
  // ═════════════════════════════════════════════════════════════════════════════

  dynamic view wtTick {
    title "Binary Obelisk/Walkthrough/3 · One tick — RECIPE-6, every parameter"

    include dispatcher, beads, claudeCli, agentMap, gitCli, forgeCli, forge, knobs, spawnEnv,
      logRun, logRun.*, workers.engineer

    dispatcher -> dispatcher "step 0 — branchesCurrentlyAtWork" {
      title "before claiming, so the ticket in hand is never counted against itself"
      notes '''
```bash
bd list --status in_progress --limit 0 --json \
  | jq -r '.[] | .metadata.branch // empty' | sort -u
# → feature/add-recipe   feature/search-recipes
```
'''
    }

    dispatcher -> claudeCli "step 1 — claude agents --json" {
      title "capacity, recounted fresh every tick"
      notes '''
```bash
jq --arg root "$towerDir/.claude/worktrees" --arg tower "$towerDir" \
   '[.[] | select(.kind=="background")
     | select((.cwd//"") | startswith($root) or . == $tower)] | length'
# → 2   <  BO_MAX_PARALLEL (4) → claim
```

Counted from the live session list rather than from a counter the loop keeps, so a session that died
without anyone noticing cannot hold a slot forever. At capacity the tick does not claim and writes a
waiting line instead.
'''
      navigateTo wtWaiting
    }

    dispatcher -> beads "step 2 — bd ready --claim --json" {
      title "the only atomic claim in the system"
      notes '''
```json
[{ "id": "RECIPE-6",
   "title": "validateRecipe + saveRecipe — pure functions",
   "status": "in_progress",
   "assignee": "brodie",
   "issue_type": "task",
   "labels": ["backend-logic"],
   "parent": "RECIPE-5",
   "metadata": { "branch": "feature/add-recipe" },
   "depends_on": [], "blocked_by": [] }]
```

What the tick reads from it, and nothing else: `.[0].id`, `.[0].labels`, `.[0].metadata.branch`,
`.[0].parent`. `metadata` is a structured field of the **claim** payload, which is why the two keys
arrive exact in one query — unlike `external_ref`, which round-trips through `bd show` but is **absent**
from the claim. No ticket text is ever parsed.

Non-zero exit → `ERROR reason=bd-failure exit=N msg="<last line of $logDir/bd-stderr>"`; exit 0 with no
`id` is the same alarm with the first 60 characters of the payload. An *empty* answer is not an error at
all — it is a waiting line.
'''
    }

    dispatcher -> agentMap "step 3 — one claim, exactly one matching key" {
      notes '''
```bash
declare -A AGENT=(
    [backend-logic]=engineer      [frontend-ui]=frontend
    [unit-tests]=tester-unit      [feature-test]=tester-feature
    [epic-e2e-test]=tester-e2e    [feature-review]=review
    [epic-review]=review          [epic-merge-pr]=merge
)
```

`labels=["backend-logic"]` hits one key → `agentName=engineer`. Zero or two hits:
`ERROR reason=label-ambiguous matched="…" labels="…"`, **left claimed** so its lease parks it off the
frontier — otherwise the loop spins on the same unworkable ticket every tick.
'''
    }

    dispatcher -> dispatcher "step 4 — branch=feature/add-recipe off the claim" {
      title "nothing re-derives it and nothing parses text"
      notes '''
Missing → `ERROR reason=metadata-missing`, same treatment: the loop never invents a branch, because a
plan agent that skipped its one key is a plan bug, not something to paper over.
'''
    }

    dispatcher -> dispatcher "step 5 — is feature/add-recipe already at work?" {
      title "one pair of hands per branch"
      notes '''
No → keep the claim. Yes → `bd unclaim`, remember the id in `skippedTicket`, try the next claim — at
most `BO_MAX_PARALLEL + 2 = 6` attempts a tick, then `CLAIMS reason=branch-busy unclaimed` and the
waiting line `branch_busy held=N`.

This is the **fallback**, not the mechanism: the graph already makes a feature one linked line, so the
frontier can only hand out one task per feature. The guard is for a tower that was never chained.
'''
    }

    dispatcher -> beads "step 6 — .[0].parent=RECIPE-5 → epicGateOf → RECIPE-1" {
      title "find the PR base by walking up, never by reading a copy"
      notes '''
`readFieldOf` is `bd show --json <id> | jq '.[0].<field>'`, at most 4 hops (a warning if it smells of a
cycle). Two hops here: RECIPE-6 → RECIPE-5 → RECIPE-1. The gate's own `branch` is the base:
`prTarget=epic/recipe-box`.

`tick()` then tests `[[ "$gateId" == "$claimParent" ]]` — if the claim's own parent **is** the topmost
gate (a ticket hanging directly off the epic, or an orphaned feature with no epic at all) the target is
`main`. A gate's `branch` is not a key on a ticket because a copy can drift from the thing it copies and
nothing compares the two: the loop once published one while the hook aimed at the other.
'''
    }

    dispatcher -> forgeCli "step 7 — ensureEpicGatePr RECIPE-1" {
      title "the epic branch has no other publisher"
      notes '''
The gate already carries `pr`, so this returns silently. On a fresh tower it: checks the gate has its own
`branch`, settles the forge, `git push`es `epic/recipe-box` off `main`, lists the PR or creates it, and
writes the url onto the gate as `pr` — logging
`CLAIMS gate=RECIPE-1 reason=epic-published gateBranch=epic/recipe-box pr=https://github.com/…/pull/1`.

That line names **no ticket of its own** — the identity the tick already carries is on it — and the gate's
branch appears as `gateBranch=`, never `branch=`, which belongs to the claim and differs from it.

Seven steps name where it died: `walk`, `gate-branch`, `forge`, `missing-tool`, `push`, `pr`, `annotate`.
Any of them: `ERROR reason=epic-pr-failed step=…`, **left claimed** — a worker spawned under an epic branch
that does not exist burns a slot and files a commit nobody can pull.
'''
    }

    dispatcher -> gitCli "step 8 — ensureWorktree feature/add-recipe epic/recipe-box" {
      title "the loop owns the folders"
      notes '''
```bash
branchAlreadyCheckedOut()   # git worktree list --porcelain → refs/heads/<branch>
git -C "$towerDir" fetch --quiet origin
git worktree add -B feature/add-recipe \
  "$towerDir/.claude/worktrees/feature+add-recipe" \
  origin/feature/add-recipe            # else origin/epic/recipe-box, else epic/recipe-box, else HEAD
```

The folder name is the branch with `/` → `+`. Failure → `ERROR reason=worktree-failed branch=… start=…`,
**left claimed**: a worker spawned into a missing folder burns a slot on nothing.
'''
    }

    dispatcher -> spawnEnv "step 9 — eight BO_* on the spawn line" {
      notes '''
```bash
( cd "$worktreePath" \
  && BO_TICKET=RECIPE-6 BO_BRANCH=feature/add-recipe BO_PR_TARGET=epic/recipe-box \
     BO_AGENT=engineer BO_LABEL=backend-logic \
     BO_PROJECT_DIR=/home/dev/recipe-box \
     BO_LOG_DIR=/home/dev/.binary-obelisk/logs/2026-11-04_09-12-01 \
     BO_DONE_FILE=…/done-RECIPE-6 \
     claude --bg --agent engineer --permission-mode bypassPermissions \
     "$(buildWorkerPrompt …)" ) >"$spawnFile" 2>&1
```

`rm -f "$doneFile"` first, so a marker can only mean *this* session. No `-w` — `claude --worktree` only
ever *creates* one.
'''
    }

    dispatcher -> claudeCli "step 9b — claude --bg --agent engineer" {
      title "fire and forget, on purpose"
      notes '''
Non-zero → `ERROR reason=worker-not-dispatched msg="<last line of spawn-RECIPE-6>"` and `bd unclaim` —
the **only** tick alarm that puts the ticket straight back, because nothing was ever spawned to work it
and the next tick may well succeed. Every other one leaves it claimed.

The loop then never polls it, never reads its output, never reaps it, never merges, never ends itself.
'''
      navigateTo wtWorker
    }

    dispatcher -> logRun.fSpawn "step 9c — spawn output → sessionFromSpawn" {
      notes '''
`backgrounded · 287d3c4c` → `session=287d3c4c` on every following line: the id a human needs to attach,
read or stop that exact worker.
'''
    }

    dispatcher -> logRun.fClaims "step 10 — one line, then move on" {
      notes '''
```
CLAIMS   2026-11-04T09:12:03	run=2026-11-04_09-12-01 repo=/home/dev/recipe-box ticket=RECIPE-6 label=backend-logic agent=engineer branch=feature/add-recipe target=epic/recipe-box session=287d3c4c worktree=/home/dev/recipe-box/.claude/worktrees/feature+add-recipe reason=dispatched
```

Nine keys on every line of every file, `"-"` for whatever is not known yet. `boClearIdentity` wipes all
but `run` and `repo` at the top of every attempt, so no line inherits a ticket from the tick before.
Anything outside the nine — `step=`, `gate=`, `exit=`, `msg=` — is passed as **detail**; the key set is
closed, or the joining stops working.
'''
    }

    autoLayout LeftRight
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // WALKTHROUGHS — 4: the run, tick by tick, with the frontier shrinking
  // ═════════════════════════════════════════════════════════════════════════════

  dynamic view wtRun {
    title "Binary Obelisk/Walkthrough/4 · The run — the frontier shrinks"

    include dispatcher, beads, claudeCli, gitCli, forgeCli, logRun, logRun.*, human,
      tower.featA.backendA, tower.featB.backendB, tower.featA.unitA, tower.featA.frontendA,
      tower.featA.featureTestA, tower.featA.featureReviewA, tower.featA, tower.featB

    dispatcher -> beads "tick 1 — bd ready --claim → RECIPE-6" {
      title "the first task of each feature has no deps, so both are the frontier"
      notes '''
`working=0`, capacity free, nothing at work yet. RECIPE-6 → `engineer` on `feature/add-recipe`, spawned.
`CLAIMS … ticket=RECIPE-6 label=backend-logic agent=engineer branch=feature/add-recipe
target=epic/recipe-box session=287d3c4c … reason=dispatched`
'''
    }

    dispatcher -> beads "tick 1, attempt 2 — bd ready --claim → RECIPE-12" {
      title "two features side by side; a feature runs alone"
      notes '''
The same tick claims again, because its branch `feature/search-recipes` is not in the busy set.
`CLAIMS … ticket=RECIPE-12 label=backend-logic agent=engineer branch=feature/search-recipes
target=epic/recipe-box session=4f9a11b7 … reason=dispatched`

RECIPE-7 (`unit-tests`) is still off the frontier — it is `blocked-by` RECIPE-6, which is now
`in_progress`. That is the chain doing the work the loop does not have to do.
'''
    }

    dispatcher -> logRun.fWaiting "tick 2 — reason=branch_busy held=1" {
      notes '''
Both branches are at work; a third claim wanted `feature/add-recipe` and went straight back.
`working=2 next=…`, at most one line a minute per reason. Errors are never capped.
'''
      navigateTo wtWaiting
    }

    dispatcher -> beads "tick 12 — RECIPE-6 lands; bd ready --claim → RECIPE-7" {
      title "the line opens one ticket at a time"
      notes '''
The Stop hook closed RECIPE-6, so RECIPE-7 (`unit-tests`) became claimable and RECIPE-8 is still waiting
behind it. `agent=tester-unit`, same branch, same worktree — `ensureWorktree` finds it already checked out
and re-enters it. A ticket is a commit; the branch is the thing that owns a folder.
'''
    }

    dispatcher -> beads "tick 30 — RECIPE-8 lands; RECIPE-9 becomes claimable" {
      title "the UI is last, so the suite is next"
      notes '''
RECIPE-9 (`feature-test`) is `blocked-by` RECIPE-8, the **last** task of the feature. Nothing is proved
against half a feature: the suite runs only after every task has landed on the branch, and the review only
after the suite.
'''
    }

    dispatcher -> beads "tick 41 — RECIPE-10 (feature-review) closes out" {
      title "then the tick goes quiet"
      notes '''
```
WAITING  2026-11-04T09:31:12	run=… ticket=- label=- agent=- branch=- target=- session=- worktree=- working=1 next=- reason=tower_stalled waiting=6
```

The other half of an empty frontier, and the two need different alarms: `bd list --status open,blocked
--limit 0` counted six work tickets, but an active blocker holds them off `bd ready` — the open gate
RECIPE-5, which **only a human** may close. A broken tower must never read as a calm one.
'''
      navigateTo wtWaiting
    }

    human -> tower.featA "verify, then close RECIPE-5" {
      notes '''
The report is the review's PR comments and the suite's green; the PR merges `feature/add-recipe` into
`epic/recipe-box`. Closing the gate is what lets RECIPE-2 (`epic-merge-pr`) off the blocked list —
`bd list` hides closed tickets and gates by default, so the count drops and the frontier opens.
'''
    }

    human -> tower.featB "verify, then close RECIPE-11" {
      notes '''
Both feature gates closed is the precondition of the epic tier: `epic-merge-pr` is `blocked-by` both gates,
so until the second human closes, that ticket simply does not exist to `bd ready`.
'''
      navigateTo wtEpic
    }

    autoLayout LeftRight
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // WALKTHROUGHS — 5: inside the worker; the six rules and the lease
  // ═════════════════════════════════════════════════════════════════════════════

  dynamic view wtWorker {
    title "Binary Obelisk/Walkthrough/5 · Inside a worker — six rules, one marker"

    include dispatcher, claudeCli, workers.engineer, beads, logRun.fDone, logRun.fSpawn, stopHook, forge

    dispatcher -> claudeCli "spawn, cwd inside the worktree, bypassPermissions" {
      navigateTo wtTick
    }

    claudeCli -> workers.engineer "the brief is the ticket, not the prompt" {
      notes '''
The prompt is six rules and nothing else. Everything about the work comes from `bd show --json RECIPE-6`,
which is why the loop never has to know what the task is:

1. keep the lease alive (`bd heartbeat`)
2. never close the ticket — report in the final message instead
3. comment what remains
4. spawn nothing
5. stay on your branch; never commit, branch, merge, rebase or push
6. `touch '$BO_LOG_DIR/done-RECIPE-6'` as the **very last action**, and only if the brief is genuinely complete
'''
    }

    workers.engineer -> beads "bd show --json RECIPE-6 — the ticket IS the brief" {
      notes '''
Requirements, edge cases, files, the tier it owns and what is `Owned Elsewhere` — all written by `plan-task`
into the ticket. `bd heartbeat RECIPE-6` keeps the 5-minute lease; if it lapses, `bd reclaim` sweeps the
ticket back to `open` for someone else.
'''
    }

    workers.engineer -> beads "bd comment RECIPE-6 — what remains" {
      title "the ticket stays open, by design"
      notes '''
A self-closed ticket is a bug. The worker's last message is the report a human reads; the human verifies
and closes. Nothing that a worker can close, a worker closes.
'''
    }

    workers.engineer -> forge "commit + push happen through the Stop hook, never from here" {
      notes '''
Rule five exists because a worker that pushes its own branch, or commits under another name, is work landing
on a branch its siblings are queued behind.
'''
    }

    workers.engineer -> logRun.fDone "touch $BO_DONE_FILE — last action, only if genuinely complete" {
      notes '''
This is the one file the worker writes. The engine `rm -f`ed it before the spawn, so its existence can only
mean this session made it — and the Stop hook is fail-closed on it.
'''
    }

    workers.engineer -> stopHook "the session ends; the harness fires Stop" {
      navigateTo wtStop
    }

    autoLayout LeftRight
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // WALKTHROUGHS — 6: the closer, in the order its refusals run
  // ═════════════════════════════════════════════════════════════════════════════

  dynamic view wtStop {
    title "Binary Obelisk/Walkthrough/6 · Stop — the fail-closed closer"

    include workers.engineer, stopHook, hooksJson, beads, gitCli, forgeCli, forge, logRun, spawnEnv,
      alarms.stopAlarms.notDeclaredDone, alarms.stopAlarms.closeFailed

    hooksJson -> stopHook "Stop, timeout 300, in every session of every project" {
      notes '''
`[[ -n "${BO_TICKET:-}" ]] || exit 0` — one line, and it is what keeps the obelisk from committing your
everyday sessions. `BO_TICKET` is the **only** test that tells a dispatched worker apart from anything else.
'''
    }

    workers.engineer -> stopHook "the session ends" {
      navigateTo wtWorker
    }

    stopHook -> spawnEnv "read the identity off the environment" {
      notes '''
`BO_TICKET RECIPE-6`, `BO_BRANCH feature/add-recipe`, `BO_PR_TARGET epic/recipe-box`, `BO_AGENT engineer`,
`BO_LABEL backend-logic`, `BO_PROJECT_DIR`, `BO_LOG_DIR`, `BO_DONE_FILE`. Then `BO_LOG_QUIET=1` before
sourcing the line format — a hook must never print into a session. `worktree=` and `session=` come from the
hook's own stdin: `.cwd` and `.session_id`, which is what ties an alarm here to the `CLAIMS` line that
spawned it.

The refusals, in the order the code checks them — each one `exit 0`, the ticket untouched:

| # | `reason=` | why it is where it is |
|---|---|---|
| 1 | `missing-tool` | `bd jq git`, then the forge CLI |
| 2 | `ticket-not-in-work` | a second Stop in a `closed` session leaves **silently** |
| 3 | `no-branch` | the spawn line had no `BO_BRANCH` |
| 4 | `no-pr-target` | the hook is aiming blind, so it refuses to aim |
| 5 | **`not-declared-done`** | **the gate** |
| 6 | `wrong-branch` | `git branch --show-current` ≠ `BO_BRANCH` (a detached tree reads `got="detached"`) |
| 7 | `ticket-has-no-title` | the commit message *is* the title |
| 8 | `commit-failed` | after `diff --cached --quiet` said there was something |
| 9 | `push-failed` | 160 characters of its stderr go in `msg=` |
| 10 | `forge-unknown` / `missing-tool` | three settle steps, none of them a guess |
| 11 | `pr-not-created` | only `/(pull\|merge_requests)/<digits>` counts |
| 12 | `ticket-not-annotated` | the work is pushed but the ticket cannot say where it went |
| 13 | `close-failed` | everything else succeeded, and nothing is recorded |
'''
    }

    stopHook -> beads "status must be in_progress, and the title must exist" {
      notes '''
`bd -C "$BO_PROJECT_DIR" show --json RECIPE-6` — **the tower, not the worktree**: the worktree is not the
tower, and `.beads` lives at the root.
'''
    }

    stopHook -> alarms.stopAlarms.notDeclaredDone "the marker is absent — nothing lands" {
      notes '''
```
ERRORS   2026-11-04T09:19:47	run=… ticket=RECIPE-6 label=backend-logic agent=engineer branch=feature/add-recipe target=epic/recipe-box session=287d3c4c worktree=…/feature+add-recipe reason=not-declared-done msg="the worker stopped without touching its done file; nothing was committed and the ticket stays open — the tasks behind it wait"
```

No commit, no push, no PR, no close. The ticket stays claimed so its lease parks it off the frontier and
every task chained behind it waits. That is the whole safety of a shared branch.

And the converse is the one failure this model cannot undo on its own: a worker that touches the marker
*early* files half a task onto a branch its siblings are queued behind.
'''
    }

    stopHook -> gitCli "git add -A; git commit -F -" {
      notes '''
```
validateRecipe + saveRecipe — pure functions

Ticket: RECIPE-6
```
'''
    }

    stopHook -> gitCli "git push -u origin feature/add-recipe"

    stopHook -> forgeCli "the PR on this branch pair, else create it" {
      notes '''
```bash
gh pr list --head feature/add-recipe --base epic/recipe-box --state open --json url -q '.[0].url // empty'
gh pr create --title feature/add-recipe --body-file $body --head feature/add-recipe --base epic/recipe-box
```
'''
    }

    stopHook -> beads "bd update RECIPE-6 --set-metadata pr=https://github.com/…/pull/2" {
      notes '''
`--set-metadata` **merges**, which is the whole reason writing `pr` is safe beside the plan's `branch`.
'''
    }

    stopHook -> beads "bd close RECIPE-6 --session 287d3c4c --reason \"worker session … finished; PR …\"" {
      notes '''
`--session` carries the real id because `bd` refuses to close a ticket whose assignee is not the actor, and
the dispatcher is the assignee — overriding the actor would be the only reason this step has ever failed.
'''
    }

    stopHook -> logRun.fCloses "CLOSES … url=https://github.com/…/pull/2" {
      notes '''
Same nine keys as the `CLAIMS` line, so the pair is findable by grepping either one.
'''
    }

    stopHook -> alarms.stopAlarms.closeFailed "if bd refuses at the last step" {
      notes '''
The commit, the push and the PR are all out there with no record in the tower. This is why the alarm is
never rate-limited.
'''
    }

    autoLayout LeftRight
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // WALKTHROUGHS — 7: a worker dies mid-turn; the ticket is parked on purpose
  // ═════════════════════════════════════════════════════════════════════════════

  dynamic view wtFail {
    title "Binary Obelisk/Walkthrough/7 · StopFailure — park the dead ticket"

    include workers.engineer, failHook, hooksJson, beads, logRun, spawnEnv

    hooksJson -> failHook "StopFailure, timeout 60"

    workers.engineer -> failHook "the harness fires it when the session dies on an API error" {
      notes '''
The reason is **never polled, parsed out of a log, or asked of the model** — the harness hands it over on
stdin: `.error` is a coarse label for the kind of death (often just `unknown`), and `.last_assistant_message`
is the last thing the session produced, which is where the real text is (for local inference, typically an
`API Error:` line from the proxy).
'''
    }

    failHook -> spawnEnv "BO_TICKET is again the only test that this is ours"

    failHook -> beads "bd show --json RECIPE-12 — only in_progress is ours to touch" {
      notes '''
Anything else is somebody else's business and the hook leaves silently: a dead session must not rewrite a
ticket another worker owns, or park a ticket that already shipped.
'''
    }

    failHook -> beads "bd update RECIPE-12 --append-notes \"Worker session … failed: unknown / Last message: API Error: 500 …\"" {
      title "the reason goes on FIRST"
      notes '''
If the note fails, the hook stops rather than parking the ticket silently — a ticket sitting in failure with
nothing said about why is worse than one left `in_progress`.
'''
    }

    failHook -> beads "bd update RECIPE-12 --status failed-agent" {
      title "out of bd reclaim's path, on purpose"
      notes '''
A dead worker stops heartbeating, its lease lapses, and `bd reclaim` would silently sweep the ticket back to
`open` for another attempt — forever, on the same failure. This moves it somewhere a human will see it, with
the reason attached, and it stays until they say otherwise. Every step is *attempted, never forced*: one that
fails leaves the ticket exactly where it was and logs why (`reason=status-not-set kind=… from=…`, and the
`failures` line never gets written, which is the tell).
'''
    }

    failHook -> logRun.fFailures "FAILURES … from=in_progress kind=unknown msg=\"API Error: 500 …\"" {
    }

    autoLayout LeftRight
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // WALKTHROUGHS — 8: the epic tier assembles
  // ═════════════════════════════════════════════════════════════════════════════

  dynamic view wtEpic {
    title "Binary Obelisk/Walkthrough/8 · The epic tier assembles"

    include human, dispatcher, beads, workers.mergeAgent, tower.featA, tower.featB, tower.epic,
      tower.epic.epicMergePr, tower.epic.epicE2e, tower.epic.epicReview, forge, forgeCli

    human -> tower.featA "close RECIPE-5"
    human -> tower.featB "close RECIPE-11" {
      notes '''
Both feature PRs merge into `epic/recipe-box`. Nothing is assembled until the gates close — `epic-merge-pr`
is `blocked-by` both, so it is not even claimable before then.
'''
    }

    dispatcher -> beads "bd ready --claim → RECIPE-2" {
      title "the one merge ticket IS dispatched, like any other stamp"
      notes '''
`metadata.branch = epic/recipe-box`, `parent = RECIPE-1`, so the PR base resolves to `main` — the claim's own
parent **is** the topmost gate. There is no exclusion filter at the claim: the `AGENT` map names `merge` for
`epic-merge-pr` and it is claimed and worked like any other ticket.
'''
    }

    dispatcher -> workers.mergeAgent "merge" {
      title "read the branches, not the code"
      notes '''
Read the feature branches off the feature gates, assemble them onto `epic/recipe-box` in its own worktree,
resolve the conflicts **between them**, run the tests, report. It writes no code and no tests, never merges
into `main`, never opens a PR — that thumbs-up is the human's.
'''
    }

    dispatcher -> beads "bd ready --claim → RECIPE-3 (epic-e2e-test)" {
      title "the broad tier, after the assembly"
      notes '''
Journeys across features on the real stack: cross-feature state handoffs, session continuity, one success and
one failure journey per feature. The least verbose tier — never the micro tier's edges, never the composition
tier's wiring. `respawn-agent: true` means a fresh session of the same agent re-checks the work inside this one
ticket: one ticket, one worker.
'''
    }

    dispatcher -> beads "bd ready --claim → RECIPE-4 (epic-review)" {
      title "three questions, from first principles"
      notes '''
Does the code do what its source of truth demands, do the tests prove it, is it simple and readable. It maps
the system the change sits in (entry → exit, following imports), instruments it with trace logs, runs the tests
against the instrumented code, and posts findings as PR comments — files no tickets, commits and pushes nothing.
'''
    }

    dispatcher -> forge "the epic PR into main exists; the loop is its only publisher" {
      notes '''
Every feature PR below it targets `epic/recipe-box`, and only the loop ever pushes that branch or opens its PR
into `main`. Which is why a failure to publish leaves a ticket claimed rather than a worker spawned.
'''
    }

    human -> tower.epic "verify, close the epic gate, thumbs-up on the PR" {
      notes '''
Release order, bottom to top: a feature's tasks in order → its suite → its review → a human closes the feature
→ the merge assembles the feature branches → epic e2e → epic review → a human closes the epic.
'''
      navigateTo index
    }

    autoLayout LeftRight
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // WALKTHROUGHS — 9: the ticks that dispatch nothing
  // ═════════════════════════════════════════════════════════════════════════════

  dynamic view wtWaiting {
    title "Binary Obelisk/Walkthrough/9 · A tick that dispatches nothing — five waiting lines"

    include dispatcher, beads, claudeCli, logRun.fWaiting, waiting.frontierEmpty, waiting.towerStalled,
      waiting.branchBusyWaiting, waiting.maxParallel, waiting.maxParallelStalled

    dispatcher -> claudeCli "claude agents --json — working=N"

    dispatcher -> waiting.maxParallel "at capacity, with tickets in progress" {
      notes '''
`reason=max_parallel in_progress=N` — the workers are working, so the tick simply does not claim.
'''
    }

    dispatcher -> waiting.maxParallelStalled "at capacity, with NOTHING in progress" {
      notes '''
`reason=max_parallel_stalled in_progress=0` — the slots are ghosts: sessions counted busy whose tickets are
gone. The capacity count comes fresh from `claude agents --json` every tick precisely so this state is visible
rather than silent.
'''
    }

    dispatcher -> beads "bd ready --claim — nothing claimable"

    dispatcher -> waiting.branchBusyWaiting "tickets existed; every branch they wanted was at work" {
      notes '''
`reason=branch_busy held=N` after `BO_MAX_PARALLEL + 2` attempts, each one `bd unclaim`ed and remembered in
`skippedTicket`.
'''
    }

    dispatcher -> beads "bd list --status open,blocked --limit 0 --json — the stall probe" {
      title "the one query that tells an empty frontier from a broken tower"
      notes '''
`bd list` hides closed tickets and gates by default, so N counts **work tickets only**.
'''
    }

    dispatcher -> waiting.frontierEmpty "probe found nothing — the calm one" {
      notes '''
`reason=frontier_empty working=0 next=-` — the tower is finished, or nobody has planned anything yet.
'''
    }

    dispatcher -> waiting.towerStalled "probe found N — work exists behind an open blocker" {
      notes '''
`reason=tower_stalled waiting=6` — an open gate, most often, which **only a human** may clear. Every waiting
line carries `working=<busy sessions>` and `next=<the id a bare bd ready would name>`, and is written at most
once a minute per reason (`60 / BO_POLL_S` ticks). An error is never capped.

Two states, and the waiting line names which: a broken tower must never read as a calm one.
'''
    }

    autoLayout LeftRight
  }

  // ═════════════════════════════════════════════════════════════════════════════
  // ERRORS — every reason= string, and what happens to the ticket when it fires
  // ═════════════════════════════════════════════════════════════════════════════

  view errorsTick {
    title "Binary Obelisk/Errors/Raised by the tick — left claimed, or put back"

    include dispatcher, beads, gitCli, claudeCli, forgeCli, forge, knobs, logRun.fErrors
    include alarms.tickAlarms.*

    autoLayout LeftRight
  }

  view errorsStop {
    title "Binary Obelisk/Errors/Raised by the Stop hook — thirteen refusals, one gate"

    include stopHook, hooksJson, beads, gitCli, forgeCli, forge, logRun.fErrors, spawnEnv
    include alarms.stopAlarms.*

    autoLayout LeftRight
  }

  view errorsFail {
    title "Binary Obelisk/Errors/Raised by the StopFailure hook — attempt, never force"

    include failHook, hooksJson, beads, logRun.fFailures, logRun.fErrors
    include alarms.failAlarms.*

    autoLayout LeftRight
  }
}
