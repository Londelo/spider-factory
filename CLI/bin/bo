#!/usr/bin/env bash
# bo — the binary-obelisk CLI. One command, `bo loop`, which runs the dispatcher in the foreground.
#   bo loop      from inside a tower project (one with a beads DB); Ctrl-C stops dispatching.
#   The engine is ../beads-loop.sh; its contract is .claude/CLAUDE.md §The dispatcher.
set -uo pipefail

usage() {
    cat <<'USAGE'
bo — binary-obelisk loop dispatcher

  bo loop     run the dispatcher over the tower in the current directory

Runs in the foreground and prints every tick, so the log is on screen the whole time.
Ctrl-C stops dispatching — the tickets it claimed stay claimed, and any worker already
spawning keeps running. Run `bo loop` again to resume.

Run it from inside a tower project (one with a beads DB).
USAGE
}

locateEngine() {
    here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
    engine="$here/../beads-loop.sh"
}

requireEngine() {
    [[ -f "$engine" ]] || {
        echo "bo: the dispatcher engine is missing at $engine — this install is broken. Re-run its CLI/install-cli.sh." >&2
        exit 1
    }
}

requireBeadsProject() {
    bd list --limit 1 --json 2>/dev/null | jq -e 'type == "array"' >/dev/null 2>&1 || {
        echo "bo: no beads DB found from $PWD — cd into a tower project and re-run." >&2
        exit 1
    }
}

dispatchOverCurrentTower() {
    requireEngine
    requireBeadsProject
    echo "bo: dispatching $PWD — Ctrl-C to stop."
    bash "$engine"
    echo "bo: the engine ended (exit $?)."
}

runRequestedCommand() {
    case "${1:-}" in
        ""|-h|--help|help)
            usage
            exit 0
            ;;
        loop)
            dispatchOverCurrentTower
            ;;
        *)
            echo "bo: unknown command '$*' — the only command is 'bo loop'. Try 'bo --help'." >&2
            exit 1
            ;;
    esac
}

locateEngine
runRequestedCommand "$@"
