#!/usr/bin/env bash
# sf — the spider-factory CLI. Six commands, all foreground, each one an engine beside it in CLI/src/.
#   Every command but bare `sf` refuses to run from outside the factory; bare `sf` goes anywhere.
#   sf loop          the dispatcher, ../beads-loop/index.sh; Ctrl-C stops dispatching.
#   sf plan:epic     the planner, ../plan-agent.sh, epic kind — it spawns the feature and task planners itself
#   sf overseer      the watcher, ../overseer-agent.sh; reads the run, writes nothing
#   sf tower         the picture, ../src/tower/index.sh; the whole database as one tree, writes nothing
#   sf commit        the committer, ../commit.sh; stages everything, subject is agent:branch:message, then pushes
#   sf hook          the worker's Stop hook, ../src/agent-hooks/; the name the worker agents' frontmatter calls
#   SF_AGENT_COMMAND (claude) — the command every agent runs through, the planners, the watcher and the workers alike
#   The contracts are .claude/CLAUDE.md §The dispatcher and §Plan agents.
set -uo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../utils/console.sh"
nameTheSpeaker sf

declare -A planKindOf=(
    [plan:epic]=epic
)

usage() {
    cat <<'USAGE'
sf — spider-factory CLI

  sf               open an agent session through SF_AGENT_COMMAND, always from the
                   factory root — you stay put if you are already inside it
  sf --help        this text
  sf loop          run the dispatcher over the tower in the current directory
  sf plan:epic     run the epic planner — it plans the features and the tasks under it itself
  sf overseer      read the tower here and report on it — reads only
  sf tower         print the whole database as one tree, in the order the loop works it
  sf commit        stage everything here, commit it, push the branch
  sf hook          run the worker's Stop hook — 'sf hook stop' finishes a worker's ticket.
                   You never type this: each worker agent's frontmatter registers it on its
                   own Stop event, and it reads its own stdin.

`sf loop` prints every tick, so the log is on screen the whole time. Ctrl-C stops
dispatching — the tickets it claimed stay claimed, and any worker already spawning
keeps running. Run `sf loop` again to resume.

`sf plan:epic` runs the one planner you talk to, in the foreground, and hands it anything
you type after the command as the prompt. It plans the epic with you, then spawns the
feature planner and waits, and the feature planner spawns a task planner per feature and
waits — the whole tower comes out of this one command:

  sf plan:epic a record box for my diary entries

`sf overseer` runs the reader in the foreground, over the tower in this directory. It
reads the beads database, the run logs under SF_LOG_ROOT and git, and reports: alive or
not, how far along the tower is, what is wrong. It has no Write, Edit or Agent tools and
`sf` is denied to it — it never runs the loop or a plan — so where the fix is a mutation
it hands you the command to run yourself:

  sf overseer
  sf overseer why has nothing been claimed for ten minutes

`sf tower` prints every ticket of every status in this directory's database as one tree —
each task inside its feature, each feature inside its epic, top to bottom in the order the
loop works them, read off the blocks graph: every ticket after the one it waits on, and a
gate last, after the review that is the only thing blocking it. Each line carries the order
its own epic's tickets actually closed and the day it closed, so a number out of step with
the page is the order having gone wrong. It reads only — nothing is claimed or closed:

  sf tower

`sf commit` stages everything in this repo and commits it with the subject
`agent:branch:message` — the agent the loop spawned you as, or 'manual' when you
typed it yourself, then the branch you are on, then your own line:

  sf commit the record box saves a diary entry

It commits, then pushes the branch to origin.

SF_AGENT_COMMAND (claude) — the command that runs an agent. Point it at your own
build and the planners and the loop's workers all run through that instead;
it is split on spaces, so it may carry its own arguments. The loop also asks it for
`agents --json` to count the workers already running, so your build has to answer
that too or the loop will spawn past SF_MAX_PARALLEL.

Every setting — SF_AGENT_COMMAND, SF_MAX_PARALLEL, SF_POLL_S, SF_MAX_TICKETS, SF_LOG_ROOT,
SF_ALLOWED_LABELS — lives in CLI/spider-factory.env, which the installer wrote there with its
defaults. Edit that file; something you export yourself still wins for one run.

Every command but bare `sf` runs only from inside the spider factory — anywhere under it, at
any depth. Bare `sf` opens a session from wherever you are. On top of that the loop, the
planner, the watcher and `sf tower` run from inside a tower project (one with a beads DB), and
`sf commit` only needs a git repo.
USAGE
}

locateEngines() {
    here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
    factoryRoot="$(cd "$here/../.." && pwd)"
    dispatcher="$here/../src/beads-loop/index.sh"
    planner="$here/../src/plan-agent.sh"
    watcher="$here/../src/overseer-agent.sh"
    towerView="$here/../src/tower/index.sh"
    committer="$here/../src/commit.sh"
    stopHook="$here/../src/agent-hooks/worker-stop.sh"
}

requireEngine() {
    [[ -f "$1" ]] || reportMissingFromInstall "engine" "$1" "Re-run its CLI/install-cli.sh"
}

requireInsideFactory() {
    case "$PWD/" in
        "$factoryRoot"/*) return 0 ;;
    esac
    die "that command runs only from inside the spider factory at $factoryRoot — cd into it, or anywhere under it, and run it again; bare 'sf' opens a session from anywhere"
}

dispatchOverCurrentTower() {
    requireInsideFactory
    requireEngine "$dispatcher"
    requireBeadsProject
    say "dispatching $PWD — Ctrl-C to stop."
    bash "$dispatcher"
    say "the engine ended (exit $?)."
}

dispatchPlanAgent() {
    local kind="$1"
    shift
    requireInsideFactory
    requireEngine "$planner"
    exec bash "$planner" "$kind" "$@"
}

dispatchCommitter() {
    requireInsideFactory
    requireEngine "$committer"
    exec bash "$committer" "$@"
}

dispatchOverseerAgent() {
    requireInsideFactory
    requireEngine "$watcher"
    exec bash "$watcher" "$@"
}

dispatchTowerView() {
    requireInsideFactory
    requireEngine "$towerView"
    exec bash "$towerView" "$@"
}

dispatchHook() {
    local which="${1:-}"
    requireInsideFactory
    case "$which" in
        stop)
            requireEngine "$stopHook"
            exec bash "$stopHook"
            ;;
        *)
            die "unknown hook '$which' — there is one: 'sf hook stop' finishes a worker's ticket."
            ;;
    esac
}

openFactorySession() {
    source "$here/../utils/user-env.sh"
    loadSpiderFactoryEnv
    (
        case "$PWD/" in
            "$factoryRoot"/*) ;;
            *) cd "$factoryRoot" || exit 1 ;;
        esac
        exec ${SF_AGENT_COMMAND:-claude} "$@"
    )
}

unknownCommand() {
    die "unknown command '$1' — there are six: 'sf loop', 'sf plan:epic', 'sf overseer', 'sf tower', 'sf commit', 'sf hook'. Try 'sf --help'."
}

runRequestedCommand() {
    local requested="${1:-}"
    if [[ -n "$requested" && -n "${planKindOf["$requested"]+set}" ]]; then
        dispatchPlanAgent "${planKindOf["$requested"]}" "${@:2}"
    fi
    case "$requested" in
        -h|--help|help)
            usage
            exit 0
            ;;
        ""|-*)
            openFactorySession "$@"
            ;;
        loop)
            dispatchOverCurrentTower
            ;;
        overseer)
            dispatchOverseerAgent "${@:2}"
            ;;
        tower)
            dispatchTowerView "${@:2}"
            ;;
        commit)
            dispatchCommitter "${@:2}"
            ;;
        hook)
            dispatchHook "${@:2}"
            ;;
        *)
            unknownCommand "$requested"
            ;;
    esac
}

locateEngines
runRequestedCommand "$@"
