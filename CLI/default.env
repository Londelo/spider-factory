# default.env — every environment variable spider-factory reads, at the value it
# gets when you set nothing. CLI/install-cli.sh copies this file to ~/.spider-factory.env
# on install and never touches that one again — edit ~/.spider-factory.env by hand. Both
# engines read it through CLI/user-env.sh before they read anything else, and a
# value you exported yourself still beats whatever is written here.

# ── yours to set ──────────────────────────────────────────────────────────────

# workers at once
SF_MAX_PARALLEL=4

# seconds per tick — must divide 60 (1 2 3 4 5 6 10 12 15 20 30 60) or the loop refuses to start
SF_POLL_S=3

# tickets the loop ends itself after — it counts tickets the Stop hook closed this run,
# and keeps ticking while it waits for them — 0 never ends
SF_MAX_TICKETS=0

# one directory per run goes under here
SF_LOG_ROOT=$HOME/.spider-factory/logs

# the dispatching labels this loop may claim — * is the whole set, a comma list narrows it
SF_ALLOWED_LABELS=*

# the command that runs an agent: the worker spawn, the worker count, and the three planners
SF_AGENT_COMMAND=claude

# the plugin the agents ship in — every spawn names one as <plugin>:<agent>, and a bare name
# does not resolve to a plugin agent
SF_AGENT_PLUGIN=spider-factory

# does the lead agent close a gate for you — 1 yes, 0 no, anything else the loop refuses to start on.
# A gate is normally a human's checkpoint; with a flag on, the lead agent verifies that tier instead
# (every ticket under it closed, the review run and its findings fixed, the tests green, the PR's
# pipeline green) and merges its PR into its target. One flag per tier — a feature gate and the epic
# gate are different amounts of trust.
SF_AGENT_FEATURE_GATES=0
SF_AGENT_EPIC_GATES=0

# ── the loop's, not yours ─────────────────────────────────────────────────────
# Written onto each worker by the spawn (CLI/beads-loop.sh spawnWorker) and read back
# by the two hooks. Set none of them; a hook told SF_TICKET is empty leaves at once,
# which is how it tells one of your sessions from one the loop spawned.
#
# SF_TICKET=          the ticket this worker holds
# SF_BRANCH=          the branch its work lands on
# SF_PR_TARGET=       where that branch's pull request aims, off its epic gate
# SF_AGENT=           the specialist its label belongs to
# SF_LABEL=           the dispatching label
# SF_PROJECT_DIR=     the tower
# SF_LOG_DIR=         this run's log directory
# SF_DONE_FILE=       the worker's own declaration that it finished — no file, no commit
# SF_LOG_QUIET=1      set by the hooks only, so a hook never prints into your session

# ── derived, cannot be set ────────────────────────────────────────────────────
# waiting-line cadence  = 60 / SF_POLL_S   one line a minute per reason
# claims tried per tick = SF_MAX_PARALLEL + 2
