# default.env — every environment variable binary-obelisk reads, at the value it
# gets when you set nothing. CLI/install-cli.sh copies this file to ~/.obelisk.env
# on install and never touches that one again — edit ~/.obelisk.env by hand. Both
# engines read it through CLI/user-env.sh before they read anything else, and a
# value you exported yourself still beats whatever is written here.

# ── yours to set ──────────────────────────────────────────────────────────────

# workers at once
BO_MAX_PARALLEL=4

# seconds per tick — must divide 60 (1 2 3 4 5 6 10 12 15 20 30 60) or the loop refuses to start
BO_POLL_S=3

# tickets the loop ends itself after — it counts tickets the Stop hook closed this run,
# and keeps ticking while it waits for them — 0 never ends
BO_MAX_TICKETS=0

# one directory per run goes under here
BO_LOG_ROOT=$HOME/.binary-obelisk/logs

# the dispatching labels this loop may claim — * is the whole set, a comma list narrows it
BO_ALLOWED_LABELS=*

# the command that runs an agent: the worker spawn, the worker count, and the three planners
BO_AGENT_COMMAND=claude

# the plugin the agents ship in — every spawn names one as <plugin>:<agent>, and a bare name
# does not resolve to a plugin agent
BO_AGENT_PLUGIN=binary-obelisk

# ── the loop's, not yours ─────────────────────────────────────────────────────
# Written onto each worker by the spawn (CLI/beads-loop.sh spawnWorker) and read back
# by the two hooks. Set none of them; a hook told BO_TICKET is empty leaves at once,
# which is how it tells one of your sessions from one the loop spawned.
#
# BO_TICKET=          the ticket this worker holds
# BO_BRANCH=          the branch its work lands on
# BO_PR_TARGET=       the base of that branch's pull request
# BO_AGENT=           the specialist its label belongs to
# BO_LABEL=           the dispatching label
# BO_PROJECT_DIR=     the tower
# BO_LOG_DIR=         this run's log directory
# BO_DONE_FILE=       the worker's own declaration that it finished — no file, no commit
# BO_LOG_QUIET=1      set by the hooks only, so a hook never prints into your session

# ── derived, cannot be set ────────────────────────────────────────────────────
# waiting-line cadence  = 60 / BO_POLL_S   one line a minute per reason
# claims tried per tick = BO_MAX_PARALLEL + 2
