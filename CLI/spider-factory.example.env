# spider-factory.example.env — every environment variable spider-factory reads, at the value it
# gets when you set nothing. CLI/install-cli.sh copies this file to CLI/spider-factory.env
# on install and never touches that one again — edit CLI/spider-factory.env by hand. Both
# engines read it through CLI/utils/user-env.sh before they read anything else, and a
# value you exported yourself still beats whatever is written here.

# ── yours to set ──────────────────────────────────────────────────────────────

# workers at once
SF_MAX_PARALLEL=4

# seconds per tick — must divide 60 (1 2 3 4 5 6 10 12 15 20 30 60) or the loop refuses to start
SF_POLL_S=3

# tickets the loop ends itself after — it counts tickets the Stop hook closed this run,
# and keeps ticking while it waits for them — 0 never ends
SF_MAX_TICKETS=0

# one directory per run goes under here
SF_LOG_ROOT=$HOME/.spider-factory/logs

# the dispatching labels this loop may claim — * is the whole set, a comma list narrows it
SF_ALLOWED_LABELS=*

# the command that runs an agent: the worker spawn, the worker count, and the three planners
SF_AGENT_COMMAND=claude

# how the Stop hook learns a worker finished instead of stopping to ask you something. Empty is Claude
# Code's own: it reads state from the daemon's job record for the session. Set it to a command and that
# command is asked instead — it gets the session id as its one argument, prints the verdict word on the
# first line of stdout (done closes the ticket; blocked, failed, stopped, or anything else leaves it
# claimed), and whatever it prints after that is what the worker is waiting on, logged with the refusal.
# Split on spaces, so it may carry its own arguments. This is the seam for a harness that is not Claude
# Code; nothing else in the hook asks the harness whether the work ended.
SF_SESSION_VERDICT_COMMAND=

# does the lead agent close a gate for you — 1 yes, 0 no, anything else the loop refuses to start on.
# A gate is normally a human's checkpoint; with a flag on, the lead agent verifies that tier instead
# (every ticket under it closed, the review run and its findings fixed, the tests green, the PR's
# pipeline green) and merges its PR into its target. One flag per tier — a feature gate and the epic
# gate are different amounts of trust.
SF_AGENT_FEATURE_GATES=0
SF_AGENT_EPIC_GATES=0

# ── the loop's, not yours ─────────────────────────────────────────────────────
# The spawn (CLI/src/beads-loop/worker.sh spawnWorker) writes no environment onto a worker at all. A
# `claude --bg` session gets the environment the shared daemon froze at the run's first spawn, so anything
# the loop set there would reach the worker and its hook as another worker's values. The facts go instead
# as literals in the worker's prompt and as the dispatch record the loop writes before it spawns — the
# claims line and the worker-context file. The Stop hook reads its worker off those, never off its own
# environment, and a session with no dispatched claims line is a human's: it writes nothing anywhere.
#
# SF_LOG_QUIET=1      set by the hook only, so a hook never prints into your session

# ── derived, cannot be set ────────────────────────────────────────────────────
# waiting-line cadence  = 60 / SF_POLL_S   one line a minute per reason
